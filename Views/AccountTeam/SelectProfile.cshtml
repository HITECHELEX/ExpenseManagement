@using ExpenseManagement.Models
@{
    Layout = null;
    var profiles    = ViewBag.Profiles as List<PortalProfile> ?? new List<PortalProfile>();
    var companyName = ViewBag.CompanyName as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Profile — ExpenseTrack</title>
    <link rel="icon" type="image/png" href="/LOGO.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: #f0f4f8;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            display: flex;
            flex-direction: column;
        }

        /* ── Top Navbar ── */
        .app-navbar {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            padding: 0 28px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 16px rgba(30,58,138,.35);
            flex-shrink: 0;
        }
        .nav-brand {
            display: flex; align-items: center; gap: 12px;
            text-decoration: none;
        }
        .nav-logo {
            width: 36px; height: 36px;
            background: rgba(255,255,255,.18);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid rgba(255,255,255,.25);
        }
        .nav-logo i { color: #fff; font-size: .95rem; }
        .nav-appname { color: #fff; font-weight: 800; font-size: 1.1rem; letter-spacing: -.3px; }
        .nav-appname span { color: rgba(255,255,255,.55); font-weight: 400; font-size: .78rem; margin-left: 6px; }
        .nav-back {
            color: rgba(255,255,255,.75); font-size: .78rem;
            text-decoration: none;
            display: flex; align-items: center; gap: 6px;
            padding: 7px 14px; border-radius: 8px;
            border: 1px solid rgba(255,255,255,.2);
            transition: all .2s;
        }
        .nav-back:hover { color: #fff; background: rgba(255,255,255,.12); border-color: rgba(255,255,255,.35); }

        /* ── Context Banner ── */
        .context-banner {
            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 60%, #2563eb 100%);
            padding: 32px 28px 0;
            position: relative; overflow: hidden;
        }
        .context-banner::after {
            content: ''; display: block; height: 30px;
            background: #f0f4f8;
            border-radius: 30px 30px 0 0;
            margin-top: 26px;
        }
        .banner-inner { max-width: 900px; margin: 0 auto; position: relative; z-index: 1; }
        .banner-eyebrow {
            color: rgba(255,255,255,.5); font-size: .68rem;
            font-weight: 700; letter-spacing: 2px;
            text-transform: uppercase; margin-bottom: 7px;
        }
        .banner-title { color: #fff; font-size: 1.55rem; font-weight: 800; letter-spacing: -.4px; margin-bottom: 12px; }
        .banner-chips  { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(255,255,255,.13); border: 1px solid rgba(255,255,255,.2);
            border-radius: 100px; padding: 4px 13px;
            color: rgba(255,255,255,.85); font-size: .73rem; font-weight: 600;
        }
        .chip i { font-size: .62rem; opacity: .8; }
        .banner-deco {
            position: absolute; border-radius: 50%;
            background: rgba(255,255,255,.045); pointer-events: none;
        }
        .bd1 { width: 220px; height: 220px; top: -90px; right: 60px; }
        .bd2 { width: 130px; height: 130px; top: 0px;  right: 200px; }

        /* ── Main Content ── */
        .main-content { flex: 1; padding: 0 28px 40px; }
        .content-wrap  { max-width: 900px; margin: 0 auto; }

        /* ── Selection Card ── */
        .select-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            box-shadow: 0 4px 24px rgba(30,58,138,.07), 0 1px 4px rgba(0,0,0,.04);
            overflow: hidden;
        }
        .card-head {
            padding: 22px 28px 18px;
            border-bottom: 1px solid #f1f5f9;
            display: flex; align-items: center;
            justify-content: space-between; gap: 12px; flex-wrap: wrap;
        }
        .card-head-left { display: flex; align-items: center; gap: 14px; }
        .head-icon {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-radius: 13px; border: 1px solid #bfdbfe;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .head-icon i { color: #2563eb; font-size: 1.05rem; }
        .head-title { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 2px; }
        .head-sub   { font-size: .78rem; color: #64748b; }
        .manage-link {
            color: #64748b; font-size: .78rem; text-decoration: none;
            display: flex; align-items: center; gap: 6px;
            padding: 7px 14px; border-radius: 8px;
            border: 1px solid #e2e8f0; background: #f8fafc;
            transition: all .2s; white-space: nowrap;
        }
        .manage-link:hover { color: #1e3a8a; border-color: #bfdbfe; background: #eff6ff; }

        .card-body-inner { padding: 26px 28px; }

        /* ── Section label ── */
        .section-divider {
            display: flex; align-items: center; gap: 10px; margin-bottom: 20px;
        }
        .section-divider::before, .section-divider::after {
            content: ''; flex: 1; height: 1px; background: #e2e8f0;
        }
        .section-divider span {
            color: #94a3b8; font-size: .67rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1.6px; white-space: nowrap;
        }

        /* ── Profile grid ── */
        .profile-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(138px, 1fr));
            gap: 12px; margin-bottom: 24px;
        }
        .profile-card {
            position: relative; cursor: pointer;
            background: #fafafa; border: 1.5px solid #e2e8f0;
            border-radius: 16px; padding: 24px 12px 18px;
            text-align: center;
            transition: border-color .18s, background .18s, transform .18s, box-shadow .18s;
            user-select: none;
        }
        .profile-card:hover {
            background: #eff6ff; border-color: #93c5fd;
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(37,99,235,.12);
        }
        .profile-card.selected {
            background: #eff6ff; border-color: #2563eb;
            transform: translateY(-4px);
            box-shadow: 0 0 0 3px rgba(37,99,235,.15), 0 12px 30px rgba(37,99,235,.14);
        }
        .profile-card input[type="radio"] { position: absolute; opacity: 0; pointer-events: none; }

        .check-badge {
            position: absolute; top: 10px; right: 10px;
            width: 22px; height: 22px; border-radius: 50%;
            background: #2563eb;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; transform: scale(.4);
            transition: opacity .18s, transform .22s cubic-bezier(.34,1.56,.64,1);
            box-shadow: 0 3px 10px rgba(37,99,235,.4);
        }
        .profile-card.selected .check-badge { opacity: 1; transform: scale(1); }
        .check-badge i { font-size: .55rem; color: #fff; }

        .avatar-circle {
            width: 60px; height: 60px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 12px;
            font-size: 1.1rem; font-weight: 800; color: #fff;
            letter-spacing: -.5px;
            box-shadow: 0 4px 14px rgba(0,0,0,.14);
            transition: transform .18s, box-shadow .18s;
        }
        .profile-card:hover .avatar-circle   { transform: scale(1.08); }
        .profile-card.selected .avatar-circle { box-shadow: 0 6px 20px rgba(37,99,235,.28); }

        .pname { color: #0f172a; font-size: .87rem; font-weight: 700; margin-bottom: 5px; line-height: 1.3; }
        .prole {
            display: inline-block; background: #dbeafe;
            color: #1d4ed8; font-size: .62rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: .7px;
            border-radius: 100px; padding: 2px 8px;
        }

        /* ── Proceed button ── */
        .btn-proceed {
            width: 100%; padding: 14px 24px;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            border: none; border-radius: 12px;
            color: #fff; font-size: .95rem; font-weight: 700; letter-spacing: .2px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: all .2s;
            box-shadow: 0 6px 22px rgba(37,99,235,.35);
            position: relative; overflow: hidden;
        }
        .btn-proceed::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,.1), transparent);
            opacity: 0; transition: opacity .2s;
        }
        .btn-proceed:hover:not(:disabled)::before { opacity: 1; }
        .btn-proceed:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(37,99,235,.45); }
        .btn-proceed:active:not(:disabled)  { transform: translateY(0); }
        .btn-proceed:disabled {
            cursor: not-allowed;
            background: #f1f5f9; color: #94a3b8;
            box-shadow: none; border: 1.5px solid #e2e8f0;
        }
        .btn-arrow { transition: transform .2s; margin-left: auto; }
        .btn-proceed:not(:disabled):hover .btn-arrow { transform: translateX(4px); }

        /* ── Security note ── */
        .security-note {
            display: flex; align-items: center; justify-content: center;
            gap: 7px; color: #94a3b8; font-size: .72rem; margin-top: 14px;
        }
        .security-note i { font-size: .65rem; }

        /* ── Empty state ── */
        .empty-state { text-align: center; padding: 52px 24px; }
        .empty-icon {
            width: 70px; height: 70px; background: #f1f5f9;
            border-radius: 18px; border: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: center; margin: 0 auto 18px;
        }
        .empty-icon i { font-size: 1.7rem; color: #94a3b8; }
        .empty-state h6 { color: #0f172a; font-weight: 700; margin-bottom: 6px; }
        .empty-state p  { color: #64748b; font-size: .84rem; margin-bottom: 20px; line-height: 1.6; }
        .btn-add {
            display: inline-flex; align-items: center; gap: 8px;
            background: linear-gradient(135deg, #1e3a8a, #2563eb);
            color: #fff; font-size: .82rem; font-weight: 600;
            padding: 10px 22px; border-radius: 10px; text-decoration: none;
            box-shadow: 0 4px 14px rgba(37,99,235,.3);
            transition: all .2s;
        }
        .btn-add:hover { color: #fff; transform: translateY(-1px); box-shadow: 0 8px 22px rgba(37,99,235,.4); }

        @@media (max-width: 600px) {
            .app-navbar    { padding: 0 16px; }
            .context-banner { padding: 22px 16px 0; }
            .main-content  { padding: 0 16px 28px; }
            .card-head     { padding: 18px 18px 14px; }
            .card-body-inner { padding: 18px; }
            .profile-grid  { grid-template-columns: repeat(2, 1fr); gap: 10px; }
            .banner-title  { font-size: 1.2rem; }
            .manage-link   { display: none; }
        }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="app-navbar">
        <a class="nav-brand" href="/">
            <div class="nav-logo"><i class="fas fa-calculator"></i></div>
            <div class="nav-appname">ExpenseTrack <span>Accounts Portal</span></div>
        </a>
        <a href="/Account/Login" class="nav-back">
            <i class="fas fa-arrow-left"></i> Back to Login
        </a>
    </nav>

    <!-- Context Banner -->
    <div class="context-banner">
        <div class="banner-deco bd1"></div>
        <div class="banner-deco bd2"></div>
        <div class="banner-inner">
            <div class="banner-eyebrow"><i class="fas fa-id-badge me-1"></i>Session Setup</div>
            <div class="banner-title">Who is working today?</div>
            <div class="banner-chips">
                <span class="chip"><i class="fas fa-shield-halved"></i>Secure Session</span>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="chip"><i class="fas fa-building"></i>@companyName</span>
                }
                <span class="chip"><i class="fas fa-users"></i>@profiles.Count Profile@(profiles.Count != 1 ? "s" : "")</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="content-wrap">
            <div class="select-card">

                <!-- Card Header -->
                <div class="card-head">
                    <div class="card-head-left">
                        <div class="head-icon"><i class="fas fa-user-check"></i></div>
                        <div>
                            <div class="head-title">Select Your Profile</div>
                            <div class="head-sub">Your name will appear on all reports and approvals you action this session</div>
                        </div>
                    </div>
                    <a href="/AccountTeam/ManageProfiles" class="manage-link">
                        <i class="fas fa-sliders"></i> Manage Profiles
                    </a>
                </div>

                <!-- Card Body -->
                <div class="card-body-inner">
                    @if (!profiles.Any())
                    {
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-users-slash"></i></div>
                            <h6>No Profiles Configured</h6>
                            <p>Add account team members so they can identify<br />themselves when reviewing reports.</p>
                            <a href="/AccountTeam/ManageProfiles" class="btn-add">
                                <i class="fas fa-plus"></i> Add Team Members
                            </a>
                        </div>
                    }
                    else
                    {
                        <form method="post" action="/AccountTeam/SelectProfile" id="profileForm">
                            @Html.AntiForgeryToken()
                            @{
                                var avatarColors = new[] {
                                    "linear-gradient(135deg,#1e3a8a,#2563eb)",
                                    "linear-gradient(135deg,#065f46,#059669)",
                                    "linear-gradient(135deg,#7c3aed,#8b5cf6)",
                                    "linear-gradient(135deg,#b45309,#d97706)",
                                    "linear-gradient(135deg,#be123c,#e11d48)",
                                    "linear-gradient(135deg,#0e7490,#0891b2)",
                                    "linear-gradient(135deg,#15803d,#16a34a)",
                                    "linear-gradient(135deg,#1d4ed8,#3b82f6)"
                                };
                                int pi = 0;
                            }

                            <div class="section-divider"><span>Choose your name to begin</span></div>

                            <div class="profile-grid">
                                @foreach (var p in profiles)
                                {
                                    var idx  = pi;
                                    var grad = avatarColors[idx % avatarColors.Length];
                                    var ini  = string.Concat(p.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
                                    <label class="profile-card" id="pcard_@idx" onclick="selectProfile(@idx,'@p.Name',@p.Id)">
                                        <input type="radio" name="profileId" value="@p.Id" id="pradio_@idx" />
                                        <div class="check-badge"><i class="fas fa-check"></i></div>
                                        <div class="avatar-circle" style="background:@grad">@ini</div>
                                        <div class="pname">@p.Name</div>
                                        <div class="prole">Accounts</div>
                                    </label>
                                    pi++;
                                }
                            </div>

                            <button type="submit" class="btn-proceed" id="proceedBtn" disabled>
                                <i class="fas fa-circle-user"></i>
                                <span id="proceedText">Select a profile to continue</span>
                                <i class="fas fa-arrow-right btn-arrow"></i>
                            </button>
                        </form>

                        <div class="security-note">
                            <i class="fas fa-lock"></i>
                            Your selection is tied to this session only and resets on logout
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>

    <script>
        function selectProfile(idx, name, id) {
            document.querySelectorAll('.profile-card').forEach(c => c.classList.remove('selected'));
            var card  = document.getElementById('pcard_'  + idx);
            var radio = document.getElementById('pradio_' + idx);
            if (card)  card.classList.add('selected');
            if (radio) radio.checked = true;
            var btn  = document.getElementById('proceedBtn');
            var text = document.getElementById('proceedText');
            if (btn)  btn.disabled = false;
            if (text) text.textContent = 'Continue as ' + name;
        }
        document.querySelectorAll('.profile-card').forEach(function (card) {
            card.setAttribute('tabindex', '0');
            card.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
            });
        });
    </script>
</body>
</html>
