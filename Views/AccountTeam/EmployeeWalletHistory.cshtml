@model ExpenseManagement.ViewModels.EmployeeWalletHistoryVM
@using ExpenseManagement.Models
@{ ViewData["Title"] = "Wallet History — " + Model.Employee.FullName; }

@{
    bool isOver = Model.WalletBalance < 0;
}

<!-- Back + Header -->
<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/AccountTeam/Budgets" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
    <div>
        <h5 class="mb-0 fw-bold">
            <i class="fas fa-user-circle me-2 text-primary"></i>@Model.Employee.FullName
            <small class="text-muted fw-normal ms-2" style="font-size:.75rem">@Model.Employee.Department</small>
        </h5>
    </div>
    <div class="ms-auto">
        <a href="/AccountTeam/AllocateBudget" class="btn btn-primary btn-sm">
            <i class="fas fa-plus-circle me-1"></i>Top Up Wallet
        </a>
    </div>
</div>

<!-- ── WALLET SUMMARY CARD ── -->
<div class="mb-4">
    <div style="background:linear-gradient(135deg,@(isOver?"#dc2626,#991b1b":"#1e3a8a,#2563eb"));border-radius:18px;padding:24px 28px;color:#fff">
        <div class="row align-items-center g-3">
            <div class="col-md-4">
                <div style="opacity:.75;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px">
                    <i class="fas fa-wallet me-1"></i>Current Wallet Balance
                </div>
                <div style="font-size:clamp(1.4rem,7vw,2.6rem);font-weight:800;letter-spacing:-1.5px;line-height:1.1;overflow-wrap:anywhere;word-break:break-all">
                    @(isOver ? "-" : "")₹@Math.Abs(Model.WalletBalance).ToString("N2")
                </div>
                @if (isOver)
                {
                    <div style="background:rgba(0,0,0,.25);border-radius:8px;padding:6px 10px;margin-top:10px;font-size:.78rem">
                        <i class="fas fa-exclamation-triangle me-1 text-warning"></i>
                        Overdrawn by ₹@Math.Abs(Model.WalletBalance).ToString("N2")
                    </div>
                }
            </div>
            <div class="col-md-8">
                <div class="row g-2 text-center">
                    <div class="col-6 col-md-3">
                        <div style="background:rgba(255,255,255,.13);border-radius:10px;padding:12px 6px;min-width:0">
                            <div style="font-size:clamp(0.6rem,2.4vw,1.05rem);font-weight:700;overflow-wrap:anywhere;word-break:break-all">₹@Model.TotalAllocated.ToString("N0")</div>
                            <div style="font-size:.66rem;opacity:.8;margin-top:2px">Total Allocated</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="background:rgba(255,255,255,.13);border-radius:10px;padding:12px 6px;min-width:0">
                            <div style="font-size:clamp(0.6rem,2.4vw,1.05rem);font-weight:700;overflow-wrap:anywhere;word-break:break-all">₹@Model.TotalSpent.ToString("N0")</div>
                            <div style="font-size:.66rem;opacity:.8;margin-top:2px">Total Spent</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="background:rgba(255,255,255,.13);border-radius:10px;padding:12px 6px;min-width:0">
                            <div style="font-size:clamp(0.75rem,2.5vw,1.05rem);font-weight:700">@Model.TotalTopUps</div>
                            <div style="font-size:.66rem;opacity:.8;margin-top:2px">Top-ups</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div style="background:rgba(255,255,255,.13);border-radius:10px;padding:12px 6px;min-width:0">
                            <div style="font-size:clamp(0.6rem,2.4vw,1.05rem);font-weight:700;overflow-wrap:anywhere;word-break:break-all">₹@Model.TotalTopUpAmount.ToString("N0")</div>
                            <div style="font-size:.66rem;opacity:.8;margin-top:2px">Total Added</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── TRANSACTION HISTORY ── -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-exchange-alt me-2"></i>Transaction History</span>
        <span class="badge bg-primary rounded-pill">@Model.Transactions.Count record(s)</span>
    </div>

    @if (!Model.Transactions.Any())
    {
        <div class="card-body text-center py-5 text-muted">
            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
            No transactions yet for this employee.
            <div class="mt-3">
                <a href="/AccountTeam/AllocateBudget" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus-circle me-1"></i>Top Up Now
                </a>
            </div>
        </div>
    }
    else
    {
        @* ── MOBILE CARD LIST ── *@
        <div class="d-md-none">
            @foreach (var tx in Model.Transactions)
            {
                bool isCredit = tx.Type == ExpenseManagement.Models.WalletTransactionType.Credit;
                bool negBal   = tx.BalanceAfter < 0;
                <div class="px-3 py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;font-size:.72rem;font-weight:700;color:#fff;background:@(isCredit ? "#16a34a" : "#dc2626");flex-shrink:0">
                                @(isCredit ? "CR" : "DR")
                            </span>
                            <span style="font-size:.85rem;font-weight:600;max-width:180px;white-space:normal">@tx.Description</span>
                        </div>
                        <div class="text-end flex-shrink-0 ms-2">
                            <div class="fw-bold @(isCredit ? "text-success" : "text-danger")" style="font-size:.9rem">
                                @(isCredit ? "+" : "-")₹@tx.Amount.ToString("N2")
                            </div>
                            <div class="fw-bold @(negBal ? "text-danger" : "text-success")" style="font-size:.9rem">
                                @(negBal ? "-" : "")₹@Math.Abs(tx.BalanceAfter).ToString("N2")
                            </div>
                            @if (negBal)
                            {
                                <div style="font-size:.66rem;color:#dc2626">Overdrawn</div>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between" style="font-size:.76rem;color:#64748b">
                        <span><i class="fas fa-user me-1"></i>@(tx.PerformedBy?.FullName ?? "System")</span>
                        <span><i class="fas fa-clock me-1"></i>@tx.Date.ToIst().ToString("dd MMM yy, hh:mm tt")</span>
                    </div>
                </div>
            }
        </div>

        @* ── DESKTOP TABLE ── *@
        <div class="d-none d-md-block">
            <table class="table table-hover mb-0" style="font-size:.875rem">
                <thead style="background:#f8fafc">
                    <tr>
                        <th class="px-4 py-3">Type</th>
                        <th class="py-3">Description</th>
                        <th class="py-3">Performed By</th>
                        <th class="py-3">Date &amp; Time</th>
                        <th class="py-3 text-end">Amount</th>
                        <th class="py-3 text-end pe-4">Balance After</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        bool isCredit = tx.Type == ExpenseManagement.Models.WalletTransactionType.Credit;
                        bool negBal   = tx.BalanceAfter < 0;
                        <tr>
                            <td class="px-4 py-3">
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;font-size:.72rem;font-weight:700;color:#fff;background:@(isCredit ? "#16a34a" : "#dc2626")">
                                    @(isCredit ? "CR" : "DR")
                                </span>
                            </td>
                            <td class="py-3" style="max-width:300px">@tx.Description</td>
                            <td class="py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:30px;height:30px;background:#e0e7ff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;color:#4338ca;flex-shrink:0">
                                        @(tx.PerformedBy?.FullName?.Substring(0, 1).ToUpper() ?? "S")
                                    </div>
                                    <span>@(tx.PerformedBy?.FullName ?? "System")</span>
                                </div>
                            </td>
                            <td class="py-3 text-muted" style="white-space:nowrap">
                                <div><i class="fas fa-calendar me-1" style="font-size:.72rem"></i>@tx.Date.ToIst().ToString("dd MMM yyyy")</div>
                                <div style="font-size:.75rem"><i class="fas fa-clock me-1"></i>@tx.Date.ToIst().ToString("hh:mm tt")</div>
                            </td>
                            <td class="py-3 text-end">
                                <span class="fw-bold @(isCredit ? "text-success" : "text-danger") fs-6">
                                    @(isCredit ? "+" : "-")₹@tx.Amount.ToString("N2")
                                </span>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <span class="fw-bold @(negBal ? "text-danger" : "text-success")">
                                    @(negBal ? "-" : "")₹@Math.Abs(tx.BalanceAfter).ToString("N2")
                                </span>
                                @if (negBal)
                                {
                                    <div style="font-size:.68rem;color:#dc2626">Overdrawn</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ── ALLOCATION / TOP-UP HISTORY ── -->
@if (Model.TopUps.Any())
{
    <div class="mb-4" style="border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(22,163,74,.10)">
        <!-- Gradient Header -->
        <div style="background:linear-gradient(135deg,#14532d,#16a34a);padding:18px 24px;color:#fff">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <div style="font-size:.72rem;opacity:.8;text-transform:uppercase;letter-spacing:.8px;margin-bottom:4px">
                        <i class="fas fa-layer-group me-1"></i>Allocation / Top-up History
                    </div>
                    <div style="font-size:1.45rem;font-weight:800;letter-spacing:-1px">
                        +₹@Model.TotalTopUpAmount.ToString("N2")
                        <span style="font-size:.82rem;font-weight:400;opacity:.8;margin-left:6px">total added</span>
                    </div>
                </div>
                <div class="d-flex gap-3 text-center">
                    <div style="background:rgba(255,255,255,.15);border-radius:10px;padding:10px 18px">
                        <div style="font-size:1.3rem;font-weight:800">@Model.TopUps.Count</div>
                        <div style="font-size:.68rem;opacity:.85">Top-up(s)</div>
                    </div>
                    <div style="background:rgba(255,255,255,.15);border-radius:10px;padding:10px 18px">
                        <div style="font-size:1.1rem;font-weight:800">
                            @(Model.TopUps.Max(t => t.Amount).ToString("N0"))
                        </div>
                        <div style="font-size:.68rem;opacity:.85">Largest (₹)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div style="background:#fff">
            @* ── MOBILE CARDS ── *@
            <div class="d-md-none">
                @{ int mIdx = 1; }
                @foreach (var tu in Model.TopUps)
                {
                    bool negM = tu.BalanceAfter < 0;
                    <div class="px-3 py-3" style="border-bottom:1px solid #f0fdf4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:28px;height:28px;background:#dcfce7;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;color:#16a34a;flex-shrink:0">
                                    @(mIdx++)
                                </div>
                                <div>
                                    <div class="fw-semibold" style="font-size:.88rem">@tu.Purpose</div>
                                    <div style="font-size:.72rem;color:#64748b">@(tu.TopUpBy?.FullName ?? "Accounts Team")</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success" style="font-size:.92rem">+₹@tu.Amount.ToString("N2")</div>
                                <div style="font-size:.72rem" class="@(negM ? "text-danger" : "text-success")">
                                    Bal: @(negM?"-":"")₹@Math.Abs(tu.BalanceAfter).ToString("N2")
                                </div>
                            </div>
                        </div>
                        <div style="font-size:.72rem;color:#94a3b8">
                            <i class="fas fa-clock me-1"></i>@tu.TopUpOn.ToIst().ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>
                }
            </div>

            @* ── DESKTOP TABLE ── *@
            <div class="d-none d-md-block table-responsive">
                <table class="table mb-0" style="font-size:.875rem">
                    <thead>
                        <tr style="background:#f0fdf4;border-bottom:2px solid #bbf7d0">
                            <th class="px-4 py-3 text-center" style="width:52px;color:#16a34a;font-size:.72rem">#</th>
                            <th class="py-3" style="color:#15803d">Purpose / Label</th>
                            <th class="py-3" style="color:#15803d">Added By</th>
                            <th class="py-3" style="color:#15803d">Date &amp; Time</th>
                            <th class="py-3 text-end" style="color:#15803d">Amount Added</th>
                            <th class="py-3 text-end pe-4" style="color:#15803d">Balance After</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int tuIdx = 1; }
                        @foreach (var tu in Model.TopUps)
                        {
                            bool negBal = tu.BalanceAfter < 0;
                            <tr style="border-bottom:1px solid #f0fdf4" class="table-row-hover">
                                <td class="px-4 py-3 text-center">
                                    <div style="width:28px;height:28px;background:#dcfce7;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:800;color:#16a34a;margin:auto">
                                        @(tuIdx++)
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-semibold">@tu.Purpose</div>
                                </td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:32px;height:32px;background:linear-gradient(135deg,#16a34a,#22c55e);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:#fff;flex-shrink:0">
                                            @(tu.TopUpBy?.FullName?.Substring(0,1).ToUpper() ?? "A")
                                        </div>
                                        <div>
                                            <div style="font-size:.85rem;font-weight:600">@(tu.TopUpBy?.FullName ?? "Accounts Team")</div>
                                            <div style="font-size:.68rem;color:#94a3b8">Accounts Team</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3" style="white-space:nowrap">
                                    <div style="font-size:.82rem;font-weight:500">
                                        <i class="fas fa-calendar-day me-1 text-success" style="font-size:.7rem"></i>
                                        @tu.TopUpOn.ToIst().ToString("dd MMM yyyy")
                                    </div>
                                    <div style="font-size:.72rem;color:#94a3b8">
                                        <i class="fas fa-clock me-1"></i>@tu.TopUpOn.ToIst().ToString("hh:mm tt")
                                    </div>
                                </td>
                                <td class="py-3 text-end">
                                    <div style="display:inline-flex;align-items:center;gap:4px;background:#dcfce7;border-radius:20px;padding:4px 12px;font-size:.88rem;font-weight:700;color:#16a34a">
                                        <i class="fas fa-arrow-up" style="font-size:.65rem"></i>
                                        ₹@tu.Amount.ToString("N2")
                                    </div>
                                </td>
                                <td class="py-3 text-end pe-4">
                                    <div class="fw-bold @(negBal ? "text-danger" : "")" style="font-size:.92rem;@(negBal ? "" : "color:#0f766e")">
                                        @(negBal ? "-" : "")₹@Math.Abs(tu.BalanceAfter).ToString("N2")
                                    </div>
                                    <div style="font-size:.68rem;color:#94a3b8">after top-up</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="background:#f0fdf4;border-top:2px solid #bbf7d0">
                            <td colspan="4" class="px-4 py-3 fw-semibold text-end" style="color:#15803d;font-size:.85rem">
                                <i class="fas fa-sigma me-1"></i>Total Allocated:
                            </td>
                            <td class="py-3 text-end">
                                <div style="display:inline-flex;align-items:center;gap:4px;background:#16a34a;border-radius:20px;padding:5px 14px;font-size:.9rem;font-weight:800;color:#fff">
                                    +₹@Model.TotalTopUpAmount.ToString("N2")
                                </div>
                            </td>
                            <td class="pe-4"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

<!-- ── BUDGET RECORDS (for audit) ── -->
@if (Model.Budgets.Any())
{
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-wallet me-2"></i>Budget Record
            <small class="text-muted fw-normal ms-2">(underlying wallet data)</small>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0" style="font-size:.83rem">
                <thead style="background:#f8fafc">
                    <tr>
                        <th class="px-4 py-2">Purpose</th>
                        <th class="py-2">Allocated</th>
                        <th class="py-2 d-none d-md-table-cell">Spent</th>
                        <th class="py-2">Balance</th>
                        <th class="py-2">Status</th>
                        <th class="py-2 d-none d-md-table-cell">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Budgets)
                    {
                        bool neg = b.RemainingBalance < 0;
                        <tr class="@(b.IsLocked ? "opacity-50" : "")">
                            <td class="px-4 py-2">@b.Purpose</td>
                            <td class="py-2">₹@b.TotalAmount.ToString("N0")</td>
                            <td class="py-2 d-none d-md-table-cell">₹@b.SpentAmount.ToString("N0")</td>
                            <td class="py-2 fw-semibold @(neg ? "text-danger" : "text-success")">
                                @(neg ? "-" : "")₹@Math.Abs(b.RemainingBalance).ToString("N0")
                            </td>
                            <td class="py-2">
                                @if (b.IsLocked)
                                { <span class="badge bg-secondary" style="font-size:.65rem"><i class="fas fa-lock me-1"></i>Closed</span> }
                                else if (b.IsActive)
                                { <span class="badge badge-approved" style="font-size:.65rem">Active</span> }
                                else
                                { <span class="badge bg-secondary" style="font-size:.65rem">Inactive</span> }
                            </td>
                            <td class="py-2 text-muted d-none d-md-table-cell">@b.AllocatedOn.ToIst().ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Opening / Carry-Forward Balance Audit Log ── *@
@if (Model.OpeningBalances.Any())
{
    <div class="card mt-4 border-warning">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="background:#fffbeb;border-bottom:1px solid #fde68a">
            <span><i class="fas fa-history me-2 text-warning"></i><strong>Opening / Carry-Forward Balances</strong></span>
            <span class="badge bg-warning text-dark rounded-pill">@Model.OpeningBalances.Count record(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size:.86rem">
                <thead style="background:#fefce8">
                    <tr>
                        <th class="px-4 py-3">Period</th>
                        <th class="py-3 text-end">Amount</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Remarks</th>
                        <th class="py-3">Added By</th>
                        <th class="py-3">Date</th>
                        <th class="py-3 text-center">Proof</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ob in Model.OpeningBalances)
                    {
                        bool isCredit = ob.Amount > 0;
                        <tr>
                            <td class="px-4 py-3 fw-semibold">@ob.Period</td>
                            <td class="py-3 text-end fw-bold @(isCredit ? "text-success" : "text-danger")">
                                @(isCredit ? "+" : "")₹@Math.Abs(ob.Amount).ToString("N2")
                            </td>
                            <td class="py-3">
                                @if (isCredit)
                                {
                                    <span class="badge" style="background:#dcfce7;color:#16a34a;font-size:.72rem">
                                        <i class="fas fa-arrow-up me-1"></i>Credit
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#fee2e2;color:#dc2626;font-size:.72rem">
                                        <i class="fas fa-arrow-down me-1"></i>Debit
                                    </span>
                                }
                            </td>
                            <td class="py-3 text-muted">@(ob.Remarks ?? "-")</td>
                            <td class="py-3">@(ob.AddedBy?.FullName ?? "Account Team")</td>
                            <td class="py-3 text-muted">@ob.AddedOn.ToIst().ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td class="py-3 text-center">
                                @if (!string.IsNullOrEmpty(ob.ProofDocumentPath))
                                {
                                    <a href="/Receipt/View?key=@Uri.EscapeDataString(ob.ProofDocumentPath)"
                                       target="_blank" class="btn btn-xs btn-outline-secondary" title="View Proof" style="font-size:.72rem;padding:2px 8px">
                                        <i class="fas fa-file-alt me-1"></i>@(ob.ProofDocumentFileName ?? "Proof")
                                    </a>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
