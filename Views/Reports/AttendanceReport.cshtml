@{
    ViewData["Title"] = "Attendance Report";

    var companies = ViewBag.Companies as IEnumerable<dynamic>;
    var departments = ViewBag.Departments as IEnumerable<string>;
    var employees = ViewBag.EmployeeFilterList;

    int selectedCompanyId = ViewBag.SelectedCompanyId;
    int selectedMonth = ViewBag.Month;
    int selectedYear = ViewBag.Year;

    string? selectedDepartment =
        ViewBag.SelectedDepartment as string;

    int? selectedEmployeeId =
        ViewBag.SelectedEmployeeId as int?;

    string? selectedStatus =
        ViewBag.SelectedStatus as string;

    string? selectedMode =
        ViewBag.SelectedMode as string;

    var summaryRows = ViewBag.SummaryRows;
    var dailyRows = ViewBag.DailyRows;
    var lateRows = ViewBag.LateRows;
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="fas fa-calendar-check me-2"></i>
                Attendance Report
            </h3>

            <div class="text-muted">
                Monthly employee attendance analysis
            </div>
        </div>

        <div class="mt-3 mt-md-0">

            <a asp-controller="Reports"
               asp-action="Index"
               asp-route-companyId="@selectedCompanyId"
               class="btn btn-outline-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Back to Reports
            </a>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- FILTERS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Reports"
                  asp-action="AttendanceReport"
                  method="get">

                <input type="hidden"
                       name="companyId"
                       value="@selectedCompanyId" />

                <div class="row g-3">

                    <!-- COMPANY -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Company
                        </label>

                        @if (User.IsInRole("Management"))
                        {
                            <select name="companyId"
                                    class="form-select"
                                    onchange="this.form.submit()">

                                @foreach (var company in ViewBag.Companies)
                                {
                                    if (company.Id == selectedCompanyId)
                                    {
                                        <option value="@company.Id"
                                                selected>
                                            @company.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@company.Id">
                                            @company.Name
                                        </option>
                                    }
                                }

                            </select>
                        }
                        else
                        {
                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.SelectedCompanyName"
                                   readonly />
                        }

                    </div>


                    <!-- MONTH -->
                    <div class="col-lg-2 col-md-3">

                        <label class="form-label fw-semibold">
                            Month
                        </label>

                        <select name="month"
                                class="form-select">

                            @for (int m = 1; m <= 12; m++)
                            {
                                var monthName =
                                    new DateTime(
                                        2000,
                                        m,
                                        1)
                                    .ToString("MMMM");

                                if (m == selectedMonth)
                                {
                                    <option value="@m"
                                            selected>
                                        @monthName
                                    </option>
                                }
                                else
                                {
                                    <option value="@m">
                                        @monthName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- YEAR -->
                    <div class="col-lg-2 col-md-3">

                        <label class="form-label fw-semibold">
                            Year
                        </label>

                        <select name="year"
                                class="form-select">

                            @for (
                                int y = DateTime.UtcNow.Year - 2;
                                y <= DateTime.UtcNow.Year + 1;
                                y++)
                            {
                                if (y == selectedYear)
                                {
                                    <option value="@y"
                                            selected>
                                        @y
                                    </option>
                                }
                                else
                                {
                                    <option value="@y">
                                        @y
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- DEPARTMENT -->
                    <div class="col-lg-2 col-md-6">

                        <label class="form-label fw-semibold">
                            Department
                        </label>

                        <select name="department"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(selectedDepartment))
                            {
                                <option value="" selected>
                                    All Departments
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Departments
                                </option>
                            }

                            @foreach (var department in departments)
                            {
                                if (department == selectedDepartment)
                                {
                                    <option value="@department"
                                            selected>
                                        @department
                                    </option>
                                }
                                else
                                {
                                    <option value="@department">
                                        @department
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- EMPLOYEE -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Employee
                        </label>

                        <select name="employeeId"
                                class="form-select">

                            @if (!selectedEmployeeId.HasValue)
                            {
                                <option value="" selected>
                                    All Employees
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Employees
                                </option>
                            }

                            @foreach (var employee in employees)
                            {
                                if (employee.Id == selectedEmployeeId)
                                {
                                    <option value="@employee.Id"
                                            selected>
                                        @employee.EmployeeCode -
                                        @employee.User.FullName
                                    </option>
                                }
                                else
                                {
                                    <option value="@employee.Id">
                                        @employee.EmployeeCode -
                                        @employee.User.FullName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- STATUS -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Attendance Status
                        </label>

                        <select name="status"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(selectedStatus))
                            {
                                <option value="" selected>
                                    All Statuses
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Statuses
                                </option>
                            }

                            @{
                                var statuses = new[]
                                {
                                    "Present",
                                    "Half Day",
                                    "Absent",
                                    "On Leave",
                                    "No Punch-In",
                                    "No Out-Punch",
                                    "Late — Review Pending"
                                };
                            }

                            @foreach (var item in statuses)
                            {
                                if (item == selectedStatus)
                                {
                                    <option value="@item"
                                            selected>
                                        @item
                                    </option>
                                }
                                else
                                {
                                    <option value="@item">
                                        @item
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- MODE -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Attendance Mode
                        </label>

                        <select name="mode"
                                class="form-select">

                            @if (string.IsNullOrWhiteSpace(selectedMode))
                            {
                                <option value="" selected>
                                    All Modes
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Modes
                                </option>
                            }

                            @if (selectedMode == "InOffice")
                            {
                                <option value="InOffice"
                                        selected>
                                    In Office
                                </option>
                            }
                            else
                            {
                                <option value="InOffice">
                                    In Office
                                </option>
                            }

                            @if (selectedMode == "Visit")
                            {
                                <option value="Visit"
                                        selected>
                                    Visit
                                </option>
                            }
                            else
                            {
                                <option value="Visit">
                                    Visit
                                </option>
                            }

                        </select>

                    </div>


                    <!-- BUTTONS -->
                    <div class="col-lg-6 col-md-12 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fas fa-filter me-1"></i>
                            Generate Report

                        </button>
                        <a asp-controller="Reports"
                           asp-action="GenerateAttendanceExcel"
                           asp-route-companyId="@ViewBag.SelectedCompanyId"
                           asp-route-month="@ViewBag.Month"
                           asp-route-year="@ViewBag.Year"
                           asp-route-department="@ViewBag.SelectedDepartment"
                           asp-route-employeeId="@ViewBag.SelectedEmployeeId"
                           asp-route-status="@ViewBag.SelectedStatus"
                           asp-route-mode="@ViewBag.SelectedMode"
                           class="btn btn-success">
                            <i class="fas fa-file-excel me-1"></i>
                            Generate Excel
                        </a>
                        <a asp-controller="Reports"
                           asp-action="AttendanceReport"
                           asp-route-companyId="@selectedCompanyId"
                           class="btn btn-outline-secondary">

                            <i class="fas fa-rotate-left me-1"></i>
                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- REPORT INFORMATION -->
    <!-- ========================================================= -->

    <div class="alert alert-light border shadow-sm mb-4">

        <div class="d-flex flex-wrap gap-4">

            <div>
                <span class="text-muted small">
                    Company
                </span>

                <div class="fw-semibold">
                    @ViewBag.SelectedCompanyName
                </div>
            </div>

            <div>
                <span class="text-muted small">
                    Reporting Period
                </span>

                <div class="fw-semibold">
                    @(new DateTime(
                        selectedYear,
                        selectedMonth,
                        1).ToString("MMMM yyyy"))
                </div>
            </div>

           <div>
    <div class="text-muted small">Generated On</div>
    <div class="fw-semibold">
        @DateTime.UtcNow.AddHours(5).AddMinutes(30).ToString("dd MMM yyyy, hh:mm tt")
    </div>
</div>

    </div>


    <!-- ========================================================= -->
    <!-- EMPLOYEE SUMMARY -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Employee Attendance Summary
                    </h5>

                    <div class="text-muted small">
                        Monthly attendance summary for employees
                    </div>
                </div>

                <span class="badge bg-light text-dark">
                    @summaryRows.Count Employees
                </span>

            </div>

        </div>


        <div class="card-body px-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Employee
                            </th>

                            <th>
                                Department
                            </th>

                            <th>
                                Working Days
                            </th>

                            <th>
                                Present
                            </th>

                            <th>
                                Half Day
                            </th>

                            <th>
                                Absent
                            </th>

                            <th>
                                Leave
                            </th>

                            <th>
                                Late
                            </th>

                            <th>
                                No Punch-In
                            </th>

                            <th>
                                No Out-Punch
                            </th>

                            <th>
                                Hours
                            </th>

                            <th>
                                Attendance %
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (summaryRows.Count == 0)
                        {
                            <tr>

                                <td colspan="12"
                                    class="text-center py-5 text-muted">

                                    No employee attendance data found
                                    for the selected filters.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var row in summaryRows)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @row.EmployeeName
                                        </div>

                                        <div class="small text-muted">
                                            @row.EmployeeCode
                                        </div>

                                    </td>

                                    <td>
                                        @(row.Department ?? "-")
                                    </td>

                                    <td>
                                        @row.WorkingDays
                                    </td>

                                    <td>
                                        @row.Present
                                    </td>

                                    <td>
                                        @row.HalfDay
                                    </td>

                                    <td>
                                        @row.Absent
                                    </td>

                                    <td>
                                        @row.Leave
                                    </td>

                                    <td>
                                        @row.Late
                                    </td>

                                    <td>
                                        @row.NoPunchIn
                                    </td>

                                    <td>
                                        @row.NoOutPunch
                                    </td>

                                    <td>
                                        @row.TotalWorkingHours.ToString("0.00")
                                    </td>

                                    <td>

                                        <span class="fw-semibold">
                                            @row.AttendancePercentage.ToString("0.00")%
                                        </span>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- LATE ATTENDANCE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">
                Late Attendance
            </h5>

            <div class="text-muted small">
                Valid late attendance excluding approved late reviews
            </div>

        </div>


        <div class="card-body px-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Date
                            </th>

                            <th>
                                Employee
                            </th>

                            <th>
                                Department
                            </th>

                            <th>
                                Check-In
                            </th>

                            <th>
                                Late Minutes
                            </th>

                            <th>
                                Late Mark
                            </th>

                            <th>
                                Review
                            </th>

                            <th>
                                Reason
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (lateRows.Count == 0)
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-4 text-muted">

                                    No late attendance found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var row in lateRows)
                            {
                                <tr>

                                    <td class="ps-4">
                                        @row.AttendanceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @row.EmployeeName
                                        </div>

                                        <div class="small text-muted">
                                            @row.EmployeeCode
                                        </div>

                                    </td>

                                    <td>
                                        @(row.Department ?? "-")
                                    </td>

                                    <td>
                                        @(row.CheckIn?.ToString("hh:mm tt") ?? "-")
                                    </td>

                                    <td>
                                        @row.LateMinutes min
                                    </td>

                                    <td>
                                        @(row.LateMarkNumber?.ToString() ?? "-")
                                    </td>

                                    <td>
                                        @row.ReviewStatus
                                    </td>

                                    <td>
                                        @(row.Reason ?? "-")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- DAILY ATTENDANCE DETAILS -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">
                Daily Attendance Details
            </h5>

            <div class="text-muted small">
                Attendance records available for the selected period
            </div>

        </div>


        <div class="card-body px-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Date
                            </th>

                            <th>
                                Employee
                            </th>

                            <th>
                                Department
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Check-In
                            </th>
                            <th>Check-In Location</th>
                           
                            <th>
                                Check-Out
                            </th>
                            <th>Check-Out Location</th>
                           
                            <th>
                                Hours
                            </th>

                            <th>
                                Late
                            </th>

                            <th>
                                Early Leave
                            </th>

                            <th>
                                Mode
                            </th>

                            <th>
                                Review
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (dailyRows.Count == 0)
                        {
                            <tr>

                                <td colspan="11"
                                    class="text-center py-4 text-muted">

                                    No attendance records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var row in dailyRows)
                            {
                                <tr>

                                    <td class="ps-4">
                                        @row.AttendanceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @row.EmployeeName
                                        </div>

                                        <div class="small text-muted">
                                            @row.EmployeeCode
                                        </div>

                                    </td>

                                    <td>
                                        @(row.Department ?? "-")
                                    </td>

                                    <td>
                                        @(row.Status ?? "-")
                                    </td>

                                    <td>
                                        @(row.CheckIn?.ToString("hh:mm tt") ?? "-")
                                    </td>
                                    <td>
    @(!string.IsNullOrWhiteSpace(row.CheckInLocationName)
        ? row.CheckInLocationName
        : "—")
</td>
                                    <td>
                                        @(row.CheckOut?.ToString("hh:mm tt") ?? "-")
                                    </td>
                                    <td>
    @(!string.IsNullOrWhiteSpace(row.CheckOutLocationName)
        ? row.CheckOutLocationName
        : "—")
</td>
                                    <td>
                                        @(row.WorkingHours?.ToString("0.00") ?? "-")
                                    </td>

                                    <td>
                                        @(row.LateMinutes > 0
                                        ? $"{row.LateMinutes} min"
                                        : "—")
                                    </td>

                                    <td>
                                       @(row.EarlyLeaveMinutes > 0
                                        ? $"{row.EarlyLeaveMinutes} min"
                                        : "—")
                                    </td>

                                    <td>
                                        @(row.AttendanceMode ?? "-")
                                    </td>

                                    <td>
                                        @(row.LateReviewStatus ?? "-")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>