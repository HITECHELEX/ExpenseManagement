@model ExpenseManagement.ViewModels.EmployeeDashboardVM
@using ExpenseManagement.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewBag.UnreadNotifications = Model.UnreadNotifications;
    var usableBudgets = Model.Budgets.Where(b => !b.IsLocked).ToList();
    int draftCount = Model.DraftReports.Count;
    bool hasBudget  = usableBudgets.Any();
    bool underLimit = draftCount < 3;
    bool canCreate  = hasBudget && underLimit;
    bool isOver     = Model.TotalBalance < 0;
    double pct      = 0;
    if (usableBudgets.Any())
    {
        var totalAmt   = usableBudgets.Sum(b => b.TotalAmount);
        var totalSpent = usableBudgets.Sum(b => b.SpentAmount);
        pct = totalAmt > 0 ? Math.Min(100, (double)(totalSpent / totalAmt * 100)) : 0;
    }
}

@* ── WALLET HERO ── *@
<div class="mb-4">
    <div style="background:linear-gradient(135deg,@(isOver ? "#991b1b,#dc2626" : "#1e3a8a,#2563eb"));border-radius:20px;padding:24px 26px;color:#fff">

        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;opacity:.75;margin-bottom:6px">
            <i class="fas fa-wallet me-2"></i>Wallet Balance
        </div>

        <div style="font-size:clamp(1.6rem,6vw,2.8rem);font-weight:800;letter-spacing:-1px;line-height:1;margin-bottom:@(isOver ? "6px" : "16px")">
            @(isOver ? "-" : "")₹@Math.Abs(Model.TotalBalance).ToString("N2")
        </div>

        @if (isOver)
        {
            <div style="font-size:.76rem;background:rgba(0,0,0,.2);border-radius:8px;padding:6px 10px;margin-bottom:16px;display:inline-block">
                <i class="fas fa-exclamation-triangle me-1 text-warning"></i>
                ₹@Math.Abs(Model.TotalBalance).ToString("N2") overspend — recovered from next top-up
            </div>
        }

        <div class="row g-2">
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.75rem,2.5vw,1rem);font-weight:700">₹@Model.TotalAllocated.ToString("N0")</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Allocated</div>
                </div>
            </div>
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.75rem,2.5vw,1rem);font-weight:700">₹@Model.TotalSpent.ToString("N0")</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Spent</div>
                </div>
            </div>
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.75rem,2.5vw,1rem);font-weight:700">@draftCount / 3</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Drafts Used</div>
                </div>
            </div>
        </div>

        @if (usableBudgets.Any())
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1" style="font-size:.72rem;opacity:.75">
                    <span>Budget Used</span>
                    <span>@pct.ToString("F0")%</span>
                </div>
                <div style="height:5px;background:rgba(255,255,255,.22);border-radius:99px;overflow:hidden">
                    <div style="height:100%;width:@pct.ToString("F1")%;background:@(pct > 90 ? "#f87171" : pct > 70 ? "#fbbf24" : "#4ade80");border-radius:99px;transition:width .5s"></div>
                </div>
            </div>
        }
    </div>
</div>

@* ── IN-PROGRESS REPORTS ── *@
<div class="mb-4">

    @* Section header *@
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h6 class="fw-bold mb-0" style="font-size:.95rem"><i class="fas fa-edit me-2 text-primary"></i>In-Progress Reports</h6>
            <div style="font-size:.73rem;color:#64748b;margin-top:2px">
                @draftCount of 3 draft slots used
                @if (!underLimit)
                {
                    <span style="color:#dc2626;font-weight:600"> · Limit reached</span>
                }
            </div>
        </div>
        @if (canCreate)
        {
            <a href="/Employee/CreateDraftReport" class="btn btn-primary btn-sm" style="border-radius:9px;padding:6px 14px">
                <i class="fas fa-plus me-1"></i>New Report
            </a>
        }
        else if (!underLimit)
        {
            <span style="font-size:.73rem;color:#dc2626;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:5px 10px;font-weight:600">
                <i class="fas fa-ban me-1"></i>3/3 Full
            </span>
        }
        else if (!hasBudget)
        {
            <span style="font-size:.73rem;color:#64748b;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:8px;padding:5px 10px">
                <i class="fas fa-lock me-1"></i>No Budget
            </span>
        }
    </div>

    @* Draft slot dots *@
    <div class="d-flex gap-1 mb-3">
        @for (int s = 0; s < 3; s++)
        {
            string dotColor = s < draftCount
                ? (draftCount == 3 ? "#ef4444" : draftCount == 2 ? "#f59e0b" : "#22c55e")
                : "#e2e8f0";
            <div style="flex:1;height:4px;border-radius:99px;background:@dotColor"></div>
        }
    </div>

    @if (!Model.DraftReports.Any())
    {
        @* Empty state *@
        <div class="text-center py-5" style="background:#f8fafc;border:1.5px dashed #e2e8f0;border-radius:16px">
            <div style="font-size:2rem;margin-bottom:10px">📋</div>
            <div class="fw-semibold" style="color:#334155;font-size:.9rem">No reports in progress</div>
            <div class="text-muted mt-1 mb-3" style="font-size:.8rem">Create a report to start adding expenses</div>
            @if (canCreate)
            {
                <a href="/Employee/CreateDraftReport" class="btn btn-primary btn-sm" style="border-radius:9px">
                    <i class="fas fa-plus me-1"></i>Create Report
                </a>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var r in Model.DraftReports.OrderByDescending(x => x.CreatedOn))
            {
                <div style="background:#fff;border:1.5px solid #e2e8f0;border-radius:14px;padding:14px 16px">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="flex-fill" style="min-width:0">
                            <div class="fw-bold text-truncate" style="font-size:.95rem">@r.ReportTitle</div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                <span style="font-size:.72rem;color:#64748b">
                                    <i class="fas fa-calendar me-1"></i>@r.CreatedOn.ToIst().ToString("dd MMM yyyy")
                                </span>
                                <span style="font-size:.72rem;color:#64748b">
                                    <i class="fas fa-receipt me-1"></i>@r.ExpenseClaims.Count expense@(r.ExpenseClaims.Count == 1 ? "" : "s")
                                </span>
                                <span style="font-size:.72rem;font-weight:600;color:@(r.TotalClaimed > 0 ? "#2563eb" : "#94a3b8")">
                                    ₹@r.TotalClaimed.ToString("N2") claimed
                                </span>
                            </div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                            <a href="/Employee/AddExpense?reportId=@r.Id"
                               class="btn btn-sm btn-primary"
                               style="border-radius:8px;font-size:.75rem;padding:5px 10px"
                               title="Add Expense">
                                <i class="fas fa-plus me-1"></i>Add
                            </a>
                            <a href="/Employee/ReportDetail/@r.Id"
                               class="btn btn-sm btn-outline-secondary"
                               style="border-radius:8px;font-size:.75rem;padding:5px 10px"
                               title="View Report">
                                <i class="fas fa-eye"></i>
                            </a>
                            <form method="post" action="/Employee/DeleteReport" class="d-inline m-0"
                                  onsubmit="return confirm('Delete \'@r.ReportTitle\'?\n\nAll expenses will be removed and any spent amount refunded to your wallet.')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reportId" value="@r.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        style="border-radius:8px;font-size:.75rem;padding:5px 10px"
                                        title="Delete Report">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── BOTTOM LINKS ── *@
<div class="d-flex gap-2">
    <a href="/Employee/MyReports" class="btn btn-outline-primary flex-fill" style="border-radius:10px;padding:9px">
        <i class="fas fa-list me-2"></i>All Reports
    </a>
    <a href="/Employee/MyBudgets" class="btn btn-outline-secondary flex-fill" style="border-radius:10px;padding:9px">
        <i class="fas fa-wallet me-2"></i>Wallet History
    </a>
</div>
