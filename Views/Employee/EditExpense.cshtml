@model ExpenseManagement.ViewModels.ExpenseClaimVM
@using ExpenseManagement.Models
@{
    ViewData["Title"] = "Edit Expense";
    var claim  = ViewBag.Claim  as ExpenseManagement.Models.ExpenseClaim;
    var report = ViewBag.Report as ExpenseManagement.Models.ExpenseReport;
    decimal walletBal  = (ViewBag.WalletBalance as decimal?) ?? 0;
    // Add back the existing expense amount so the display shows "available if this expense didn't exist"
    decimal adjustedBal = walletBal + (claim?.Amount ?? 0);
    bool isOverspent = adjustedBal < 0;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Employee/ReportDetail/@report?.Id" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Back
    </a>
    <h5 class="mb-0">Edit Expense in "@report?.ReportTitle"</h5>
</div>

@if (report != null)
{
    var cardColor = isOverspent ? "linear-gradient(135deg,#dc2626,#b91c1c)" : "linear-gradient(135deg,#2563eb,#1d4ed8)";
    <div class="card mb-3 border-0" style="background:@cardColor;color:#fff;border-radius:14px">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span style="opacity:.85;font-size:.82rem">
                    <i class="fas fa-wallet me-1"></i>@(isOverspent ? "⚠️ Wallet Over Budget" : "Wallet Balance")
                </span>
                <span style="opacity:.7;font-size:.78rem">@report.ReportTitle</span>
            </div>
            <div style="font-size:2rem;font-weight:700">
                @(isOverspent ? "-" : "")₹@Math.Abs(adjustedBal).ToString("N2")
            </div>
            <div style="margin-top:4px;font-size:.78rem;opacity:.8">
                Available budget (excluding this expense)
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><i class="fas fa-edit me-2"></i>Expense Details</div>
    <div class="card-body">
        <form method="post" action="/Employee/EditExpense/@claim?.Id" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BudgetId" value="@claim?.BudgetId" />
            <input type="hidden" name="ReportId"  value="@report?.Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Expense Date <span class="text-danger">*</span></label>
                    <input type="date" name="ExpenseDate" class="form-control"
                           value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Amount (₹) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" name="Amount" class="form-control no-spinner" id="amtInput"
                               value="@Model.Amount" step="any" min="0.01" required
                               style="-webkit-appearance:none;-moz-appearance:textfield;" />
                    </div>
                    <small class="text-muted">Available balance: ₹@adjustedBal.ToString("N2") — you can exceed this limit</small>
                    <div id="overspendWarn" class="mt-1 p-2 rounded d-none" style="background:#fef9c3;border:1px solid #fbbf24;font-size:.8rem">
                        <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                        <span id="overspendMsg"></span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Expense Title <span class="text-danger">*</span></label>
                    <input type="text" name="Title" class="form-control" value="@Model.Title"
                           placeholder="e.g. Hotel stay, Cab fare, Lunch with client" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <select name="Category" class="form-select" required>
                        <option value="">Select category</option>
                        @foreach (var cat in new[] { "Travel","Accommodation","Food & Meals","Communication","Office Supplies","Client Entertainment","Training","Medical","Miscellaneous","Tax Invoice","Others" })
                        {
                            <option value="@cat" selected="@(Model.Category == cat ? "selected" : null)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Description <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" name="Description" class="form-control" value="@Model.Description"
                           placeholder="Brief description (optional)" />
                </div>

                <!-- Payment Method -->
                <div class="col-12">
                    <label class="form-label fw-semibold">Payment Method <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3 mt-1">
                        <label class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border"
                               id="lbl-cash" style="cursor:pointer;flex:1;transition:.2s">
                            <input type="radio" name="PaymentMethod" value="Cash" id="pmCash"
                                   @(Model.PaymentMethod == PaymentMethod.Cash ? "checked" : "")
                                   onchange="onPaymentChange()" style="accent-color:#2563eb;width:18px;height:18px" />
                            <span>
                                <i class="fas fa-money-bill-wave me-1 text-success"></i>
                                <span class="fw-semibold">Cash</span>
                                <div style="font-size:.72rem;color:#64748b">Receipt photo optional</div>
                            </span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border"
                               id="lbl-upi" style="cursor:pointer;flex:1;transition:.2s">
                            <input type="radio" name="PaymentMethod" value="UPI" id="pmUpi"
                                   @(Model.PaymentMethod == PaymentMethod.UPI ? "checked" : "")
                                   onchange="onPaymentChange()" style="accent-color:#2563eb;width:18px;height:18px" />
                            <span>
                                <i class="fas fa-mobile-alt me-1 text-primary"></i>
                                <span class="fw-semibold">UPI / Online</span>
                                <div style="font-size:.72rem;color:#64748b">Receipt photo required</div>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Bill / Receipt Photos (up to 3) -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        Bill / Receipt Photo
                        <span id="receiptRequired" class="d-none text-danger">*</span>
                        <span id="receiptOptional" class="text-muted fw-normal" style="font-size:.8rem">(optional for cash)</span>
                    </label>
                    <div style="font-size:.78rem;color:#64748b;margin-bottom:8px">
                        <i class="fas fa-info-circle me-1 text-primary"></i>
                        Up to <strong>3 photos</strong>. Leave blank to keep existing. UPI requires at least 1.
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        @{
                            var slots = new[]
                            {
                                (1, "Receipt",  claim?.ReceiptPath,  claim?.ReceiptFileName,  "Photo 1"),
                                (2, "Receipt2", claim?.Receipt2Path, claim?.Receipt2FileName, "Photo 2 (optional)"),
                                (3, "Receipt3", claim?.Receipt3Path, claim?.Receipt3FileName, "Photo 3 (optional)"),
                            };
                        }
                        @foreach (var (slotNum, inputName, existingPath, existingName, slotLabel) in slots)
                        {
                            string slotId  = slotNum == 1 ? "billFile" : $"billFile{slotNum}";
                            string zoneId  = $"zone{slotNum}";
                            string prevId  = $"prev{slotNum}";
                            bool hasExisting = !string.IsNullOrEmpty(existingPath);
                            string extE = hasExisting ? System.IO.Path.GetExtension(existingPath!).ToLower() : "";
                            <div style="flex:1;min-width:140px;max-width:210px">
                                @if (hasExisting)
                                {
                                    <div class="mb-1 p-2 rounded-2 text-center" style="background:#f0fdf4;border:1px solid #86efac;font-size:.72rem">
                                        <div class="fw-semibold text-success mb-1">Current</div>
                                        @if (extE == ".pdf")
                                        {
                                            <a href="@existingPath" target="_blank" class="btn btn-outline-danger btn-sm" style="font-size:.7rem;padding:2px 8px">
                                                <i class="fas fa-file-pdf me-1"></i>View PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@existingPath" target="_blank">
                                                <img src="@existingPath" style="height:50px;width:50px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0" />
                                            </a>
                                        }
                                        <div class="text-muted mt-1" style="font-size:.68rem">@(existingName ?? "Receipt")</div>
                                        <div class="text-muted" style="font-size:.65rem">Upload below to replace</div>
                                    </div>
                                }
                                <div id="@zoneId"
                                     onclick="document.getElementById('@slotId').click()"
                                     style="border:2px dashed #cbd5e1;border-radius:12px;padding:12px 8px;text-align:center;cursor:pointer;background:#f8fafc;transition:.2s;min-height:90px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px">
                                    <div class="d-flex gap-2 align-items-center justify-content-center">
                                        <i class="fas fa-camera" style="font-size:1.15rem;color:#94a3b8"></i>
                                        <span style="color:#cbd5e1;font-size:.75rem">|</span>
                                        <i class="fas fa-file-pdf" style="font-size:1.05rem;color:#fca5a5"></i>
                                    </div>
                                    <div style="font-size:.7rem;color:#64748b;font-weight:600">@slotLabel</div>
                                    <div style="font-size:.6rem;color:#94a3b8">Photo or PDF</div>
                                </div>
                                <input type="file" name="@inputName" id="@slotId" class="d-none"
                                       accept="image/*,.pdf"
                                       onchange="handleSlot(@slotNum, this)" />
                                <div id="@prevId" class="d-none mt-1 text-center">
                                    <img id="@(prevId)img" style="max-height:60px;max-width:100%;border-radius:8px;border:1px solid #e2e8f0" class="d-none" />
                                    <div id="@(prevId)pdf" class="d-none">
                                        <i class="fas fa-file-pdf text-danger" style="font-size:1.3rem"></i>
                                        <div id="@(prevId)name" style="font-size:.65rem;color:#64748b;word-break:break-all"></div>
                                    </div>
                                    <button type="button" onclick="clearSlot(@slotNum)"
                                            class="btn btn-sm btn-outline-danger mt-1"
                                            style="font-size:.68rem;padding:2px 7px">
                                        <i class="fas fa-times"></i> Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-primary flex-fill"
                        onclick="submitEdit(this)">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
                <a href="/Employee/ReportDetail/@report?.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<style>
/* Hide up/down spinner arrows on number inputs */
input[type=number].no-spinner::-webkit-inner-spin-button,
input[type=number].no-spinner::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
input[type=number].no-spinner {
    -moz-appearance: textfield;
}
</style>
<script>
const adjustedBalance = @adjustedBal;
const existingAmount  = @(claim?.Amount ?? 0);
const amtInput = document.getElementById('amtInput');
const overspendWarn = document.getElementById('overspendWarn');
const overspendMsg  = document.getElementById('overspendMsg');

amtInput.addEventListener('input', function () {
    const val = parseFloat(this.value) || 0;
    const newBalance = adjustedBalance - val;
    if (newBalance < 0) {
        overspendMsg.textContent = `This expense will exceed budget by ₹${Math.abs(newBalance).toFixed(2)}. It will be recovered from your next allocation.`;
        overspendWarn.classList.remove('d-none');
    } else {
        overspendWarn.classList.add('d-none');
    }
});

function onPaymentChange() {
    const isCash  = document.getElementById('pmCash').checked;
    const lblCash = document.getElementById('lbl-cash');
    const lblUpi  = document.getElementById('lbl-upi');
    const reqSpan = document.getElementById('receiptRequired');
    const optSpan = document.getElementById('receiptOptional');

    if (isCash) {
        document.getElementById('billFile').removeAttribute('required');
        lblCash.style.borderColor = '#2563eb'; lblCash.style.background = '#eff6ff';
        lblUpi.style.borderColor  = '';        lblUpi.style.background  = '';
        reqSpan.classList.add('d-none');
        optSpan.classList.remove('d-none');
    } else {
        // Only require receipt if no existing photo is already saved
        @if (string.IsNullOrEmpty(claim?.ReceiptPath) && string.IsNullOrEmpty(claim?.Receipt2Path) && string.IsNullOrEmpty(claim?.Receipt3Path))
        {
            <text>document.getElementById('billFile').setAttribute('required', 'required');</text>
        }
        lblUpi.style.borderColor  = '#2563eb'; lblUpi.style.background  = '#eff6ff';
        lblCash.style.borderColor = '';        lblCash.style.background = '';
        reqSpan.classList.remove('d-none');
        optSpan.classList.add('d-none');
    }
}
onPaymentChange();

// ── Form submit with UPI receipt validation ──
function submitEdit(btn) {
    const form = btn.closest('form');
    const isUpi = document.getElementById('pmUpi').checked;
    const receipt1 = document.getElementById('billFile');
    // Only require upload if no existing receipt is saved AND no new file chosen
    const hasExisting = @((!string.IsNullOrEmpty(claim?.ReceiptPath) || !string.IsNullOrEmpty(claim?.Receipt2Path) || !string.IsNullOrEmpty(claim?.Receipt3Path)) ? "true" : "false");

    if (isUpi && !hasExisting && receipt1.files.length === 0) {
        receipt1.setCustomValidity('Please upload a receipt photo for UPI / Online payments.');
        form.reportValidity();
        receipt1.setCustomValidity('');
        return;
    }
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
    form.submit();
}

// ── Multi-slot receipt upload ──
function handleSlot(slot, input) {
    const file = input.files[0];
    if (!file) return;
    const zone  = document.getElementById('zone'  + slot);
    const prev  = document.getElementById('prev'  + slot);
    const imgEl = document.getElementById('prev'  + slot + 'img');
    const pdfEl = document.getElementById('prev'  + slot + 'pdf');
    const nameEl = document.getElementById('prev' + slot + 'name');

    prev.classList.remove('d-none');
    zone.style.borderColor = '#2563eb';
    zone.style.background  = '#eff6ff';

    if (file.type === 'application/pdf') {
        if (imgEl) imgEl.classList.add('d-none');
        if (pdfEl) pdfEl.classList.remove('d-none');
        if (nameEl) nameEl.textContent = file.name;
    } else {
        if (pdfEl) pdfEl.classList.add('d-none');
        if (imgEl) { imgEl.classList.remove('d-none'); const r = new FileReader(); r.onload = e => imgEl.src = e.target.result; r.readAsDataURL(file); }
    }
}

function clearSlot(slot) {
    const inputId = slot === 1 ? 'billFile' : 'billFile' + slot;
    document.getElementById(inputId).value = '';
    const prev = document.getElementById('prev' + slot);
    if (prev) prev.classList.add('d-none');
    const imgEl = document.getElementById('prev' + slot + 'img');
    if (imgEl) imgEl.src = '';
    const pdfEl = document.getElementById('prev' + slot + 'pdf');
    if (pdfEl) pdfEl.classList.add('d-none');
    const zone = document.getElementById('zone' + slot);
    if (zone) { zone.style.borderColor = ''; zone.style.background = '#f8fafc'; }
}
</script>
}
