@model ExpenseManagement.ViewModels.ExpenseClaimVM
@{ 
    ViewData["Title"] = "Add Expense";
    var report = ViewBag.Report as ExpenseManagement.Models.ExpenseReport;
    decimal remaining = (ViewBag.WalletBalance as decimal?) ?? report?.Budget?.RemainingBalance ?? 0;
    var isOverspent = remaining < 0;
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Employee/ReportDetail/@report?.Id" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i>Back</a>
    <h5 class="mb-0">Add Expense to "@report?.ReportTitle"</h5>
</div>

@if (report != null)
{
    var cardColor = isOverspent ? "linear-gradient(135deg,#dc2626,#b91c1c)" : "linear-gradient(135deg,#2563eb,#1d4ed8)";
    <div class="card mb-3 border-0" style="background:@cardColor;color:#fff;border-radius:14px">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span style="opacity:.85;font-size:.82rem">
                    <i class="fas fa-wallet me-1"></i>@(isOverspent ? "⚠️ Wallet Over Budget" : "Wallet Balance")
                </span>
                <span style="opacity:.7;font-size:.78rem">@report.ReportTitle</span>
            </div>
            <div style="font-size:2rem;font-weight:700">
                @(isOverspent ? "-" : "")₹@Math.Abs(remaining).ToString("N2")
            </div>
            @if (isOverspent)
            {
                <div style="margin-top:6px;font-size:.78rem;background:rgba(0,0,0,.2);border-radius:8px;padding:5px 10px">
                    <i class="fas fa-info-circle me-1"></i>
                    You can still add expenses. The overspend will be auto-deducted from your next budget allocation.
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><i class="fas fa-receipt me-2"></i>Expense Details</div>
    <div class="card-body">
        <form method="post" action="/Employee/AddExpense" enctype="multipart/form-data" id="expenseForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BudgetId" value="@report?.BudgetId" />
            <input type="hidden" name="ReportId" value="@report?.Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Expense Date <span class="text-danger">*</span></label>
                    <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Amount (₹) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" name="Amount" class="form-control no-spinner" placeholder="0.00"
                               step="any" min="0.01" required id="amtInput"
                               style="-webkit-appearance:none;-moz-appearance:textfield;" />
                    </div>
                    @if (!isOverspent)
                    {
                        <small class="text-muted">Balance: ₹@remaining.ToString("N2") — you can exceed this limit</small>
                    }
                    else
                    {
                        <small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Already ₹@Math.Abs(remaining).ToString("N2") over budget</small>
                    }
                    <div id="overspendWarn" class="mt-1 p-2 rounded d-none" style="background:#fef9c3;border:1px solid #fbbf24;font-size:.8rem">
                        <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                        <span id="overspendMsg"></span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Expense Title <span class="text-danger">*</span></label>
                    <input type="text" name="Title" class="form-control" placeholder="e.g. Hotel stay, Cab fare, Lunch with client" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <select name="Category" id="categorySelect" class="form-select" required>
                        <option value="">Select category</option>
                        <option>Travel</option>
                        <option>Accommodation</option>
                        <option>Food & Meals</option>
                        <option>Communication</option>
                        <option>Office Supplies</option>
                        <option>Client Entertainment</option>
                        <option>Training</option>
                        <option>Medical</option>
                        <option>Miscellaneous</option>
                        <option>Tax Invoice</option>
                        <option>Others</option>
                    </select>
                    <!-- Guideline hint popup -->
                    <div id="categoryHint" style="display:none;margin-top:8px;border-radius:10px;border:1px solid #bfdbfe;background:#eff6ff;padding:10px 13px;font-size:.82rem;animation:hintIn .18s ease">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fas fa-book-open" style="color:#2563eb;font-size:.85rem"></i>
                            <span class="fw-semibold" style="color:#1e40af" id="hintTitle"></span>
                            <a href="/Employee/ExpenseGuideline" target="_blank" style="margin-left:auto;font-size:.75rem;color:#2563eb;text-decoration:none;white-space:nowrap">
                                Full policy <i class="fas fa-external-link-alt" style="font-size:.65rem"></i>
                            </a>
                        </div>
                        <div id="hintBody" style="color:#1e3a8a;line-height:1.7"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Description <span class="text-muted fw-normal">(optional)</span></label>
                    <input type="text" name="Description" class="form-control" placeholder="Brief description (optional)" />
                </div>

                <!-- Payment Method -->
                <div class="col-12">
                    <label class="form-label fw-semibold">Payment Method <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3 mt-1">
                        <label class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border cursor-pointer"
                               id="lbl-cash"
                               style="cursor:pointer;border-color:#2563eb!important;background:#eff6ff;flex:1;transition:.2s">
                            <input type="radio" name="PaymentMethod" value="Cash" id="pmCash" checked
                                   onchange="onPaymentChange()" style="accent-color:#2563eb;width:18px;height:18px" />
                            <span>
                                <i class="fas fa-money-bill-wave me-1 text-success"></i>
                                <span class="fw-semibold">Cash</span>
                                <div style="font-size:.72rem;color:#64748b">Receipt photo optional</div>
                            </span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-4 py-3 rounded-3 border cursor-pointer"
                               id="lbl-upi"
                               style="cursor:pointer;flex:1;transition:.2s">
                            <input type="radio" name="PaymentMethod" value="UPI" id="pmUpi"
                                   onchange="onPaymentChange()" style="accent-color:#2563eb;width:18px;height:18px" />
                            <span>
                                <i class="fas fa-mobile-alt me-1 text-primary"></i>
                                <span class="fw-semibold">UPI / Online</span>
                                <div style="font-size:.72rem;color:#64748b">Receipt photo required</div>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Bill / Receipt Photos (max 3) -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        Bill / Receipt Photo
                        <span id="receiptRequired" class="d-none text-danger">*</span>
                        <span id="receiptOptional" class="text-muted fw-normal" style="font-size:.8rem">(optional for cash)</span>
                    </label>
                    <div style="font-size:.78rem;color:#64748b;margin-bottom:8px">
                        <i class="fas fa-info-circle me-1 text-primary"></i>
                        You can upload up to <strong>3 photos</strong>. UPI payments require at least 1.
                    </div>

                    <!-- 3 upload slots -->
                    <div class="d-flex gap-2 flex-wrap">
                        @for (int slot = 1; slot <= 3; slot++)
                        {
                            string slotId    = slot == 1 ? "billFile"  : $"billFile{slot}";
                            string inputName = slot == 1 ? "Receipt"   : $"Receipt{slot}";
                            string previewId = $"prev{slot}";
                            string zoneId    = $"zone{slot}";
                            string label     = slot == 1 ? "Photo 1" : $"Photo {slot} (optional)";
                            <div style="flex:1;min-width:120px;max-width:200px">
                                <div id="@zoneId"
                                     onclick="document.getElementById('@slotId').click()"
                                     style="border:2px dashed #cbd5e1;border-radius:12px;padding:14px 8px;text-align:center;cursor:pointer;background:#f8fafc;transition:.2s;min-height:110px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px">
                                    <div class="d-flex gap-2 align-items-center justify-content-center">
                                        <i class="fas fa-camera" style="font-size:1.2rem;color:#94a3b8"></i>
                                        <span style="color:#cbd5e1;font-size:.75rem">|</span>
                                        <i class="fas fa-file-pdf" style="font-size:1.1rem;color:#fca5a5"></i>
                                    </div>
                                    <div style="font-size:.72rem;color:#64748b;margin-top:2px;font-weight:600">@label</div>
                                    <div style="font-size:.62rem;color:#94a3b8">Photo or PDF</div>
                                </div>
                                <input type="file" name="@inputName" id="@slotId" class="d-none"
                                       accept="image/*,.pdf"
                                       onchange="handleSlot(@slot, this)" />
                                <div id="@previewId" class="d-none mt-1 text-center">
                                    <img id="@(previewId)img" style="max-height:70px;max-width:100%;border-radius:8px;border:1px solid #e2e8f0" class="d-none" />
                                    <div id="@(previewId)pdf" class="d-none">
                                        <i class="fas fa-file-pdf text-danger" style="font-size:1.5rem"></i>
                                        <div id="@(previewId)name" style="font-size:.68rem;color:#64748b;word-break:break-all"></div>
                                    </div>
                                    <button type="button" onclick="clearSlot(@slot)"
                                            class="btn btn-sm btn-outline-danger mt-1"
                                            style="font-size:.7rem;padding:2px 8px">
                                        <i class="fas fa-times"></i> Remove
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-primary flex-fill" id="submitBtn"
                        onclick="submitExpense(this)">
                    <i class="fas fa-plus me-2"></i>Add Expense
                </button>
                <a href="/Employee/ReportDetail/@report?.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<style>
@@keyframes hintIn {
    from { opacity: 0; transform: translateY(-5px); }
    to   { opacity: 1; transform: translateY(0);    }
}
/* Hide up/down spinner arrows on number inputs */
input[type=number].no-spinner::-webkit-inner-spin-button,
input[type=number].no-spinner::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}
input[type=number].no-spinner {
    -moz-appearance: textfield;
}
</style>
<script>
// ── Category guideline hints (sourced from Expense Guideline policy) ──
const categoryHints = {
    'Travel': {
        title: 'Travel Limits',
        color: { bg: '#fffbeb', border: '#fcd34d', text: '#78350f', titleColor: '#92400e', icon: 'fa-car', iconColor: '#f59e0b' },
        rows: [
            { icon: 'fa-car',        color: '#f59e0b', text: '<strong>₹5 / km</strong> — Four Wheeler <span style="color:#b45309">(prior supervisor permission required)</span>' },
            { icon: 'fa-motorcycle', color: '#0ea5e9', text: '<strong>₹4 / km</strong> — Two Wheeler (no prior permission needed)' },
            { icon: 'fa-times-circle', color: '#ef4444', text: 'Home ↔ Office commute is <strong>not claimable</strong>' },
            { icon: 'fa-paperclip',  color: '#6b7280', text: 'Attach <strong>fuel bills</strong> + distance claim as proof' },
        ]
    },
    'Accommodation': {
        title: 'Accommodation Limits',
        color: { bg: '#eff6ff', border: '#bfdbfe', text: '#1e3a8a', titleColor: '#1e40af', icon: 'fa-hotel', iconColor: '#2563eb' },
        rows: [
            { icon: 'fa-city',     color: '#2563eb', text: '<strong>₹1,200 / night</strong> — Metro cities' },
            { icon: 'fa-building', color: '#6b7280', text: '<strong>₹1,000 / night</strong> — Other cities' },
            { icon: 'fa-paperclip', color: '#6b7280', text: 'Attach <strong>booking confirmation</strong> as proof' },
        ]
    },
    'Food & Meals': {
        title: 'Food & Meal Limits',
        color: { bg: '#f0fdf4', border: '#86efac', text: '#14532d', titleColor: '#166534', icon: 'fa-utensils', iconColor: '#16a34a' },
        rows: [
            { icon: 'fa-coffee',   color: '#f59e0b', text: '<strong>₹100 / day</strong> — Breakfast (before 9 AM)' },
            { icon: 'fa-utensils', color: '#16a34a', text: '<strong>₹250 / day</strong> — Lunch or Dinner' },
            { icon: 'fa-check-circle', color: '#16a34a', text: 'Applies to <strong>outdoor / site visits only</strong>' },
            { icon: 'fa-times-circle', color: '#ef4444', text: 'Water & snacks during local visits are <strong>not claimable</strong>' },
        ]
    },
    'Communication': {
        title: 'Communication',
        color: { bg: '#f0f9ff', border: '#7dd3fc', text: '#0c4a6e', titleColor: '#0369a1', icon: 'fa-phone', iconColor: '#0ea5e9' },
        rows: [
            { icon: 'fa-info-circle', color: '#0ea5e9', text: 'No fixed per-claim limit — keep within your overall budget' },
            { icon: 'fa-paperclip',   color: '#6b7280', text: 'Attach phone / internet <strong>bills as proof</strong>' },
        ]
    },
    'Office Supplies': {
        title: 'Office Supplies',
        color: { bg: '#faf5ff', border: '#d8b4fe', text: '#3b0764', titleColor: '#6d28d9', icon: 'fa-box', iconColor: '#7c3aed' },
        rows: [
            { icon: 'fa-info-circle', color: '#7c3aed', text: 'No fixed per-claim limit — keep within your overall budget' },
            { icon: 'fa-paperclip',   color: '#6b7280', text: 'Attach <strong>purchase receipt</strong> as proof' },
        ]
    },
    'Client Entertainment': {
        title: 'Client Entertainment',
        color: { bg: '#fff7ed', border: '#fdba74', text: '#7c2d12', titleColor: '#c2410c', icon: 'fa-handshake', iconColor: '#ea580c' },
        rows: [
            { icon: 'fa-info-circle',  color: '#ea580c', text: 'No fixed per-claim limit — keep within your overall budget' },
            { icon: 'fa-check-circle', color: '#16a34a', text: 'Must be a <strong>genuine business-related</strong> expense' },
            { icon: 'fa-paperclip',    color: '#6b7280', text: 'Attach <strong>bill / receipt</strong> as proof' },
        ]
    },
    'Training': {
        title: 'Training',
        color: { bg: '#ecfdf5', border: '#6ee7b7', text: '#064e3b', titleColor: '#047857', icon: 'fa-graduation-cap', iconColor: '#059669' },
        rows: [
            { icon: 'fa-info-circle', color: '#059669', text: 'No fixed per-claim limit — keep within your overall budget' },
            { icon: 'fa-paperclip',   color: '#6b7280', text: 'Attach <strong>enrollment confirmation</strong> or fee receipt' },
        ]
    },
    'Medical': {
        title: 'Medical',
        color: { bg: '#fff1f2', border: '#fda4af', text: '#881337', titleColor: '#be123c', icon: 'fa-heartbeat', iconColor: '#e11d48' },
        rows: [
            { icon: 'fa-info-circle',  color: '#e11d48', text: 'No fixed per-claim limit — keep within your overall budget' },
            { icon: 'fa-check-circle', color: '#16a34a', text: 'Must be a <strong>work-related</strong> medical expense' },
            { icon: 'fa-paperclip',    color: '#6b7280', text: 'Attach <strong>prescription + medical bills</strong> as proof' },
        ]
    },
    'Miscellaneous': {
        title: 'Miscellaneous',
        color: { bg: '#f8fafc', border: '#cbd5e1', text: '#1e293b', titleColor: '#334155', icon: 'fa-ellipsis-h', iconColor: '#64748b' },
        rows: [
            { icon: 'fa-check-circle',  color: '#16a34a', text: 'Expense must be clearly <strong>work-related</strong>' },
            { icon: 'fa-times-circle',  color: '#ef4444', text: '<strong>Personal expenses</strong> are not reimbursable' },
            { icon: 'fa-times-circle',  color: '#ef4444', text: 'Water & snacks during local visits are <strong>not claimable</strong>' },
            { icon: 'fa-paperclip',     color: '#6b7280', text: 'Attach a valid <strong>bill / receipt</strong> as proof' },
        ]
    },
    'Tax Invoice': {
        title: 'Tax Invoice',
        color: { bg: '#fefce8', border: '#fde68a', text: '#713f12', titleColor: '#92400e', icon: 'fa-file-invoice', iconColor: '#d97706' },
        rows: [
            { icon: 'fa-info-circle',  color: '#d97706', text: 'For GST / tax-related business expenses' },
            { icon: 'fa-check-circle', color: '#16a34a', text: 'Attach the <strong>original tax invoice</strong> with GSTIN details' },
            { icon: 'fa-paperclip',    color: '#6b7280', text: 'Invoice must be in the <strong>company\'s name</strong>' },
        ]
    },
    'Others': {
        title: 'Others',
        color: { bg: '#f8fafc', border: '#cbd5e1', text: '#1e293b', titleColor: '#334155', icon: 'fa-question-circle', iconColor: '#64748b' },
        rows: [
            { icon: 'fa-check-circle', color: '#16a34a', text: 'Expense must be clearly <strong>work-related</strong>' },
            { icon: 'fa-info-circle',  color: '#64748b', text: 'Provide a clear <strong>description</strong> of the expense' },
            { icon: 'fa-paperclip',    color: '#6b7280', text: 'Attach a valid <strong>bill / receipt</strong> as proof' },
        ]
    }
};

const categorySelect = document.getElementById('categorySelect');
const categoryHint   = document.getElementById('categoryHint');
const hintTitle      = document.getElementById('hintTitle');
const hintBody       = document.getElementById('hintBody');

categorySelect.addEventListener('change', function () {
    const hint = categoryHints[this.value];
    if (!hint) { categoryHint.style.display = 'none'; return; }

    const c = hint.color;
    categoryHint.style.background   = c.bg;
    categoryHint.style.borderColor  = c.border;
    categoryHint.style.color        = c.text;

    hintTitle.innerHTML = `<i class="fas ${c.icon}" style="color:${c.iconColor}"></i> ${hint.title}`;
    hintTitle.style.color = c.titleColor;

    hintBody.innerHTML = hint.rows.map(r =>
        `<div class="d-flex align-items-start gap-2">
            <i class="fas ${r.icon} mt-1 flex-shrink-0" style="color:${r.color};font-size:.78rem"></i>
            <span>${r.text}</span>
        </div>`
    ).join('');

    // Re-trigger animation
    categoryHint.style.animation = 'none';
    categoryHint.offsetHeight; // reflow
    categoryHint.style.animation = 'hintIn .18s ease';
    categoryHint.style.display = 'block';
});

const currentBalance = @remaining;
const amtInput = document.getElementById('amtInput');
const overspendWarn = document.getElementById('overspendWarn');
const overspendMsg = document.getElementById('overspendMsg');

amtInput.addEventListener('input', function() {
    const val = parseFloat(this.value) || 0;
    const newBalance = currentBalance - val;
    if (newBalance < 0) {
        const over = Math.abs(newBalance).toFixed(2);
        overspendMsg.textContent = `This expense will exceed budget by ₹${over}. It will be recovered from your next allocation.`;
        overspendWarn.classList.remove('d-none');
    } else {
        overspendWarn.classList.add('d-none');
    }
});

// ── Payment Method toggle ──
function onPaymentChange() {
    const isCash   = document.getElementById('pmCash').checked;
    const lblCash  = document.getElementById('lbl-cash');
    const lblUpi   = document.getElementById('lbl-upi');
    const reqSpan  = document.getElementById('receiptRequired');
    const optSpan  = document.getElementById('receiptOptional');
    const zone1    = document.getElementById('zone1');

    if (isCash) {
        document.getElementById('billFile').removeAttribute('required');
        lblCash.style.borderColor = '#2563eb'; lblCash.style.background = '#eff6ff';
        lblUpi.style.borderColor  = '';        lblUpi.style.background  = '';
        reqSpan.classList.add('d-none');
        optSpan.classList.remove('d-none');
        if (zone1) zone1.style.borderColor = '';
    } else {
        document.getElementById('billFile').setAttribute('required', 'required');
        lblUpi.style.borderColor  = '#2563eb'; lblUpi.style.background  = '#eff6ff';
        lblCash.style.borderColor = '';        lblCash.style.background = '';
        reqSpan.classList.remove('d-none');
        optSpan.classList.add('d-none');
        if (zone1) zone1.style.borderColor = '#f59e0b';
    }
}
onPaymentChange();

// ── Multi-slot receipt upload ──
function handleSlot(slot, input) {
    const file = input.files[0];
    if (!file) return;
    const zoneId   = 'zone'   + slot;
    const prevId   = 'prev'   + slot;
    const imgId    = 'prev'   + slot + 'img';
    const pdfId    = 'prev'   + slot + 'pdf';
    const nameId   = 'prev'   + slot + 'name';
    const zone     = document.getElementById(zoneId);
    const prev     = document.getElementById(prevId);
    const imgEl    = document.getElementById(imgId);
    const pdfEl    = document.getElementById(pdfId);
    const nameEl   = document.getElementById(nameId);

    prev.classList.remove('d-none');
    zone.style.borderColor = '#2563eb';
    zone.style.background  = '#eff6ff';

    if (file.type === 'application/pdf') {
        imgEl.classList.add('d-none');
        pdfEl.classList.remove('d-none');
        if (nameEl) nameEl.textContent = file.name;
    } else {
        pdfEl.classList.add('d-none');
        imgEl.classList.remove('d-none');
        const reader = new FileReader();
        reader.onload = e => { imgEl.src = e.target.result; };
        reader.readAsDataURL(file);
    }
}

// ── Form submit with UPI receipt validation ──
function submitExpense(btn) {
    const form = document.getElementById('expenseForm');
    const isUpi = document.getElementById('pmUpi').checked;
    const receipt1 = document.getElementById('billFile');

    if (isUpi && receipt1.files.length === 0) {
        receipt1.setCustomValidity('Please upload a receipt photo for UPI / Online payments.');
        form.reportValidity();
        receipt1.setCustomValidity('');
        return;
    }
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Adding...';
    form.submit();
}

function clearSlot(slot) {
    const inputId  = slot === 1 ? 'billFile' : 'billFile' + slot;
    const zoneId   = 'zone'  + slot;
    const prevId   = 'prev'  + slot;
    const imgId    = 'prev'  + slot + 'img';
    const pdfId    = 'prev'  + slot + 'pdf';
    document.getElementById(inputId).value = '';
    document.getElementById(prevId).classList.add('d-none');
    const imgEl = document.getElementById(imgId);
    if (imgEl) imgEl.src = '';
    const pdfEl = document.getElementById(pdfId);
    if (pdfEl) pdfEl.classList.add('d-none');
    const zone = document.getElementById(zoneId);
    if (zone) { zone.style.borderColor = ''; zone.style.background = '#f8fafc'; }
}
</script>
}
