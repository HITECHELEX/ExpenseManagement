@model ExpenseManagement.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";

    var managers =
        ViewBag.Managers as List<ExpenseManagement.Models.Employee>
        ?? new List<ExpenseManagement.Models.Employee>();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Edit Employee</h2>
            <p class="text-muted mb-0">
                Update the employee's HR profile.
            </p>
        </div>

        <a asp-controller="HRMEmployee"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Details
        </a>

    </div>


    <!-- Existing User Information -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="fas fa-user me-2"></i>
                Employee User
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Full Name
                    </small>
                    <strong>@Model.User.FullName</strong>
                </div>

                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Official Email
                    </small>
                    <strong>@Model.User.Email</strong>
                </div>

                <div class="col-md-4">
                    <small class="text-muted d-block">
                        Department
                    </small>
                    <strong>
                        @(Model.User.Department ?? "-")
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <form asp-controller="HRMEmployee"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- Personal Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Personal Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmployeeCode"
                               class="form-label">
                            Employee Code *
                        </label>

                        <input asp-for="EmployeeCode"
                               class="form-control" />

                        <span asp-validation-for="EmployeeCode"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="DateOfBirth"
                               class="form-label">
                            Date of Birth
                        </label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-3 mb-3">

                        <label asp-for="Gender"
                               class="form-label">
                            Gender
                        </label>

                        <select asp-for="Gender"
                                class="form-select">

                            <option value="">-- Select --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>

                        </select>

                    </div>

                    <!-- Aadhaar Number -->

<div class="col-md-6 mb-3">

    <label asp-for="AadhaarNumber"
           class="form-label">
        Aadhaar Number
    </label>

    <input asp-for="AadhaarNumber"
           class="form-control"
           maxlength="20"
           placeholder="Enter Aadhaar number" />

    <span asp-validation-for="AadhaarNumber"
          class="text-danger">
    </span>

</div>


<!-- PAN Number -->

<div class="col-md-6 mb-3">

    <label asp-for="PANNumber"
           class="form-label">
        PAN Number
    </label>

    <input asp-for="PANNumber"
           class="form-control"
           maxlength="20"
           placeholder="Enter PAN number" />

    <span asp-validation-for="PANNumber"
          class="text-danger">
    </span>

</div>

<!-- Medical History -->

<div class="col-md-12 mb-3">

    <label asp-for="MedicalHistory"
           class="form-label">
        Medical History
    </label>

    <textarea asp-for="MedicalHistory"
              class="form-control"
              rows="4"
              placeholder="Enter relevant medical history, if any"></textarea>

    <span asp-validation-for="MedicalHistory"
          class="text-danger">
    </span>

</div>

                </div>

            </div>

        </div>


        <!-- Contact Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Contact Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="Phone"
                               class="form-label">
                            Phone
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="AlternatePhone"
                               class="form-label">
                            Alternate Phone
                        </label>

                        <input asp-for="AlternatePhone"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="PersonalEmail"
                               class="form-label">
                            Personal Email
                        </label>

                        <input asp-for="PersonalEmail"
                               type="email"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmergencyContactName"
                               class="form-label">
                            Emergency Contact Name
                        </label>

                        <input asp-for="EmergencyContactName"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="EmergencyContactPhone"
                               class="form-label">
                            Emergency Contact Phone
                        </label>

                        <input asp-for="EmergencyContactPhone"
                               class="form-control" />

                    </div>

                </div>

            </div>

        </div>


        <!-- Employment Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Employment Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="JoiningDate"
                               class="form-label">
                            Joining Date
                        </label>

                        <input asp-for="JoiningDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Designation"
                               class="form-label">
                            Designation
                        </label>

                        <input asp-for="Designation"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="EmploymentType"
                               class="form-label">
                            Employment Type
                        </label>

                        <select asp-for="EmploymentType"
                                class="form-select">

                            <option value="">-- Select --</option>
                            <option value="Full Time">Full Time</option>
                            <option value="Part Time">Part Time</option>
                            <option value="Contract">Contract</option>
                            <option value="Intern">Intern</option>

                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="EmploymentStatus"
                               class="form-label">
                            Employment Status
                        </label>

                        <select asp-for="EmploymentStatus"
                                class="form-select">

                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="On Notice">On Notice</option>

                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="ReportingManagerId"
                               class="form-label">
                            Reporting Manager
                        </label>

                        <select asp-for="ReportingManagerId"
                                class="form-select">

                            <option value="">
                                -- No Reporting Manager --
                            </option>

                            @foreach (var manager in managers)
                            {
                                <option value="@manager.Id">
                                    @manager.User.FullName
                                    @(string.IsNullOrWhiteSpace(manager.Designation)
                                        ? ""
                                        : $" - {manager.Designation}")
                                </option>
                            }

                        </select>

                        <small class="text-muted">
                            Optional
                        </small>

                    </div>

                </div>

            </div>

        </div>

        <!-- Employee Category -->

<div class="card shadow-sm mb-4">

    <div class="card-header bg-white">

        <h5 class="mb-0">
            <i class="fas fa-tags me-2"></i>
            Employee Category
        </h5>

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 mb-3">

                <div class="form-check form-switch">

                    <input asp-for="IsIDBI"
                           class="form-check-input"
                           type="checkbox"
                           id="IsIDBI" />

                    <label class="form-check-label"
                           for="IsIDBI">

                        <strong>IDBI</strong>

                    </label>

                </div>

                <small class="text-muted">
                    Employee salary account is with IDBI Bank.
                </small>

            </div>


            <div class="col-md-4 mb-3">

                <div class="form-check form-switch">

                    <input asp-for="IsNonIDBI"
                           class="form-check-input"
                           type="checkbox"
                           id="IsNonIDBI" />

                    <label class="form-check-label"
                           for="IsNonIDBI">

                        <strong>Non-IDBI</strong>

                    </label>

                </div>

                <small class="text-muted">
                    Employee salary account is not with IDBI Bank.
                </small>

            </div>


            <div class="col-md-4 mb-3">

                <div class="form-check form-switch">

                    <input asp-for="IsOnSite"
                           class="form-check-input"
                           type="checkbox"
                           id="IsOnSite" />

                    <label class="form-check-label"
                           for="IsOnSite">

                        <strong>On Site</strong>

                    </label>

                </div>

                <small class="text-muted">
                    Employee works on site.
                </small>

            </div>

        </div>

    </div>

</div>

<!-- Bank Details -->

<!-- Bank Details -->

<div class="card shadow-sm mb-4">

    <div class="card-header bg-white">
        <h5 class="mb-0">
            Bank Details
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">

                <label asp-for="BankName"
                       class="form-label">
                    Bank Name
                </label>

                <input asp-for="BankName"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter bank name" />

                <span asp-validation-for="BankName"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="BankBranch"
                       class="form-label">
                    Bank Branch
                </label>

                <input asp-for="BankBranch"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter bank branch" />

                <span asp-validation-for="BankBranch"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="BankAccountNumber"
                       class="form-label">
                    Bank Account Number
                </label>

                <input asp-for="BankAccountNumber"
                       class="form-control"
                       maxlength="50"
                       placeholder="Enter bank account number" />

                <span asp-validation-for="BankAccountNumber"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="BankIFSCCode"
                       class="form-label">
                    Bank IFSC Code
                </label>

                <input asp-for="BankIFSCCode"
                       class="form-control"
                       maxlength="50"
                       placeholder="Enter IFSC code" />

                <span asp-validation-for="BankIFSCCode"
                      class="text-danger">
                </span>

            </div>

            <div class="col-md-6 mb-3">

                <label asp-for="BankAccountHolderName"
                       class="form-label">
                    Account Holder Name
                </label>

                <input asp-for="BankAccountHolderName"
                       class="form-control"
                       maxlength="150"
                       placeholder="Enter account holder name" />

                <span asp-validation-for="BankAccountHolderName"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

</div>

        <!-- Address Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Address Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="PresentAddress"
                               class="form-label">
                            Present Address
                        </label>

                        <textarea asp-for="PresentAddress"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="AadhaarAddress"
                               class="form-label">
                            Aadhaar Address
                        </label>

                        <textarea asp-for="AadhaarAddress"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="City"
                               class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="State"
                               class="form-label">
                            State
                        </label>

                        <input asp-for="State"
                               class="form-control" />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Pincode"
                               class="form-label">
                            Pincode
                        </label>

                        <input asp-for="Pincode"
                               class="form-control" />

                    </div>

                </div>

            </div>

        </div>


        <!-- Exit Information -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Exit Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ExitDate"
                               class="form-label">
                            Exit Date
                        </label>

                        <input asp-for="ExitDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="ExitReason"
                               class="form-label">
                            Exit Reason
                        </label>

                        <input asp-for="ExitReason"
                               class="form-control" />

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->

        <div class="d-flex justify-content-end gap-2 mb-5">

            <a asp-controller="HRMEmployee"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-light">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                <i class="fas fa-save me-1"></i>
                Save Changes
            </button>

        </div>

    </form>

</div>