@model List<ExpenseManagement.Models.Leave>

@{
    ViewData["Title"] = "Leave Management";

    var selectedCompanyId = ViewBag.SelectedCompanyId as int?;
    var selectedCompanyName = ViewBag.SelectedCompanyName as string;
    var companies = ViewBag.Companies as List<ExpenseManagement.Models.Company>;

    var selectedFromDate = ViewBag.FromDate as DateTime?;
    var selectedToDate = ViewBag.ToDate as DateTime?;
    var selectedStatus = ViewBag.Status as string;
    var selectedLeaveType = ViewBag.LeaveType as string;
}
<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Leave Management
            </h2>

            <p class="text-muted mb-0">
                View employee leave information
            </p>
        </div>

    </div>


    <!-- Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                Filters
            </h5>
        </div>

        <div class="card-body">

            <form method="get"
                  asp-controller="Leave"
                  asp-action="Management">

                <div class="row g-3 align-items-end">

                    <!-- Company -->
                    <div class="col-md-3">

                        <label class="form-label">
                            Company
                        </label>

                        <select name="companyId"
                                class="form-select"
                                onchange="this.form.submit()">

                            @if (companies != null)
                            {
                                foreach (var company in companies)
                                {
                                    <option value="@company.Id"
                                            selected="@(company.Id == selectedCompanyId)">
                                        @company.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- From -->
                    <div class="col-md-2">

                        <label class="form-label">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               class="form-control"
                               value="@(selectedFromDate?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- To -->
                    <div class="col-md-2">

                        <label class="form-label">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               class="form-control"
                               value="@(selectedToDate?.ToString("yyyy-MM-dd"))" />

                    </div>


                    <!-- Leave Type -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Leave Type
                        </label>

                        <select name="leaveType"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="CL"
                                    selected="@(selectedLeaveType == "CL")">
                                CL
                            </option>

                            <option value="SL"
                                    selected="@(selectedLeaveType == "SL")">
                                SL
                            </option>

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="Pending"
                                    selected="@(selectedStatus == "Pending")">
                                Pending
                            </option>

                            <option value="Approved"
                                    selected="@(selectedStatus == "Approved")">
                                Approved
                            </option>

                            <option value="Rejected"
                                    selected="@(selectedStatus == "Rejected")">
                                Rejected
                            </option>

                            <option value="Cancelled"
                                    selected="@(selectedStatus == "Cancelled")">
                                Cancelled
                            </option>

                        </select>

                    </div>


                    <!-- Filter -->
                    <div class="col-md-1">


                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="fas fa-filter me-1"></i>
                            Filter
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Leave Records -->
    <div class="card shadow-sm">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0 fw-bold">
                Employee Leave Records
            </h5>

            <span class="text-muted small">
                @Model.Count record(s)
            </span>

        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    No leave records found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Employee</th>
                                <th>Employee Code</th>
                                <th>Type</th>
                                <th>From</th>
                                <th>To</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Applied On</th>
                                <th>HR Remarks</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var leave in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @leave.Employee?.User?.FullName
                                        </span>
                                    </td>


                                    <td>
                                        @leave.Employee?.EmployeeCode
                                    </td>


                                    <td>
                                        <span class="fw-semibold">
                                            @leave.LeaveType
                                        </span>
                                    </td>


                                    <td>
                                        @leave.FromDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @leave.ToDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @(leave.TotalDays?.ToString("0.##") ?? "-")
                                    </td>


                                    <td>

                                        @if (leave.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (leave.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (leave.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else if (leave.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @leave.Status
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @(leave.AppliedOn?.ToLocalTime()
                                            .ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(leave.HRRemarks)
                                            ? "-"
                                            : leave.HRRemarks)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>