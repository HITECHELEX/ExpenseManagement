@using System.Security.Claims

@{
    var userName = User.Identity?.Name ?? "User";

    var role = User.FindFirst(
        ClaimTypes.Role)?.Value ?? "";

    var companyName = User.FindFirst("CompanyName")?.Value ?? "";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isEmployee = role == "Employee";
    var isHR = role == "HR";
    var isManagement = role == "Management";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HRM Tools
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #f1f5f9;
                color: #0f172a;
            }

            /* =========================================
                       SIDEBAR
                       ========================================= */

            .hrm-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 293px;
                height: 100vh;
                background: linear-gradient( 180deg, #1e3a5f 0%, #0f1f38 100% );
                color: white;
                z-index: 1040;
                overflow-y: auto;
            }

            .hrm-brand {
                height: 74px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .hrm-brand-icon {
                width: 38px;
                height: 38px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255,255,255,.12);
                margin-right: 12px;
            }

            .hrm-brand-title {
                font-size: 20px;
                font-weight: 700;
                letter-spacing: -.3px;
            }

            .hrm-brand-subtitle {
                font-size: 13px;
                color: #94a3b8;
                margin-top: 2px;
            }

            /* User section */

            .hrm-user-section {
                padding: 16px 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .hrm-user-name {
                font-size: 14px;
                color: #cbd5e1;
                margin-bottom: 7px;
            }

            .hrm-company {
                font-size: 13px;
                color: #60a5fa;
            }

            /* Navigation */

            .hrm-nav {
                padding: 22px 12px;
            }

            .hrm-section-title {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1.2px;
                color: #7890ad;
                padding: 0 14px;
                margin: 20px 0 8px;
                text-transform: uppercase;
            }

            .hrm-nav-link {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 11px 14px;
                margin: 3px 0;
                border-radius: 7px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 14px;
                transition: all .2s ease;
            }

                .hrm-nav-link i {
                    width: 18px;
                    text-align: center;
                    font-size: 14px;
                }

                .hrm-nav-link:hover {
                    background: rgba(255,255,255,.08);
                    color: white;
                }

                .hrm-nav-link.active {
                    background: #2563eb;
                    color: white;
                }

                .hrm-nav-link.disabled {
                    opacity: .55;
                    cursor: default;
                }

                    .hrm-nav-link.disabled:hover {
                        background: transparent;
                    }

            /* Logout */

            .hrm-sidebar-bottom {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                border-top: 1px solid rgba(255,255,255,.08);
                padding: 12px;
                background: rgba(10,20,40,.25);
            }

            .hrm-logout {
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 11px 14px;
                color: #cbd5e1;
                text-decoration: none;
                font-size: 14px;
                border-radius: 7px;
            }

                .hrm-logout:hover {
                    background: rgba(255,255,255,.08);
                    color: white;
                }

            /* =========================================
                       MAIN CONTENT
                       ========================================= */

            .hrm-main {
                margin-left: 293px;
                min-height: 100vh;
            }

            /* Top bar */

            .hrm-topbar {
                height: 72px;
                background: white;
                border-bottom: 1px solid #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 27px;
            }

            .hrm-topbar-title {
                font-size: 18px;
                font-weight: 500;
                color: #0f172a;
            }

            .hrm-topbar-right {
                display: flex;
                align-items: center;
                gap: 20px;
            }

            .hrm-company-badge {
                background: #eff6ff;
                color: #2563eb;
                padding: 7px 12px;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 600;
            }

            .hrm-user-display {
                color: #475569;
                font-size: 14px;
            }

                .hrm-user-display i {
                    margin-right: 6px;
                }

            /* Page */

            .hrm-page-content {
                padding: 42px 54px;
            }

            /* =========================================
                       MOBILE
                       ========================================= */

            .hrm-mobile-toggle {
                display: none;
                border: 0;
                background: transparent;
                font-size: 20px;
                color: #1e3a5f;
            }

            .hrm-overlay {
                display: none;
            }

            @@media (max-width: 900px) {

                .hrm-sidebar {
                    transform: translateX(-100%);
                    transition: transform .25s ease;
                }

                    .hrm-sidebar.open {
                        transform: translateX(0);
                    }

                .hrm-main {
                    margin-left: 0;
                }

                .hrm-mobile-toggle {
                    display: block;
                }

                .hrm-page-content {
                    padding: 25px 18px;
                }

                .hrm-overlay.open {
                    display: block;
                    position: fixed;
                    inset: 0;
                    background: rgba(0,0,0,.45);
                    z-index: 1030;
                }

                .hrm-topbar {
                    padding: 0 18px;
                }

                .hrm-topbar-title {
                    display: none;
                }

                .hrm-company-badge {
                    display: none;
                }
            }

    </style>

</head>


<body>

    <!-- =========================================
         HRM SIDEBAR
         ========================================= -->

    <aside id="hrmSidebar"
           class="hrm-sidebar">

        <!-- Brand -->

        <div class="hrm-brand">

            <div class="hrm-brand-icon">
                <i class="fas fa-users"></i>
            </div>

            <div>

                <div class="hrm-brand-title">
                    HRM Tools
                </div>

                <div class="hrm-brand-subtitle">
                    Human Resource Management
                </div>

            </div>

        </div>


        <!-- User -->

        <div class="hrm-user-section">

            <div class="hrm-user-name">
                @userName
            </div>

            @if (!string.IsNullOrWhiteSpace(companyName))
            {
                <div class="hrm-company">

                    <i class="fas fa-building me-1"></i>

                    @companyName

                </div>
            }

        </div>


        <!-- Navigation -->

        <nav class="hrm-nav">

            <div class="hrm-section-title">
                Main
            </div>


            <!-- Dashboard -->

            <a asp-controller="@(isEmployee ? "HRMEmployee" : isHR ? "HR" : "HRMManagement")"
               asp-action="Dashboard"
               class="hrm-nav-link @(currentAction == "Dashboard" ? "active" : "")">

                <i class="fas fa-home"></i>

                <span>
                    Dashboard
                </span>

            </a>


            @if (isEmployee)
            {
                <!-- Employee -->

                <div class="hrm-section-title">
                    My HR
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-user"></i>

                    <span>
                        My Profile
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        My Attendance
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-days"></i>

                    <span>
                        My Leave
                    </span>

                </a>


                <div class="hrm-section-title">
                    Payroll
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-money-check-dollar"></i>

                    <span>
                        My Payroll
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-file-lines"></i>

                    <span>
                        My Salary Slips
                    </span>

                </a>
            }


            @if (isHR)
            {
                <!-- ================================
         HR NAVIGATION
         ================================ -->

                <div class="hrm-section-title">
                    Employee Management
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-users"></i>

                    <span>
                        Employees
                    </span>

                </a>


                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        Attendance
                    </span>

                </a>


                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-days"></i>

                    <span>
                        Leave Management
                    </span>

                </a>


                <!-- Payroll -->

                <div class="hrm-section-title">
                    Payroll
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-money-check-dollar"></i>

                    <span>
                        Payroll
                    </span>

                </a>


                <!-- Performance -->

                <div class="hrm-section-title">
                    Performance
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-chart-line"></i>

                    <span>
                        Performance
                    </span>

                </a>


                <!-- Reports -->

                <div class="hrm-section-title">
                    Reports
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-chart-column"></i>

                    <span>
                        Reports
                    </span>

                </a>
            }


            @if (isManagement)
            {
                <!-- Management -->

                <div class="hrm-section-title">
                    HR Management
                </div>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-users"></i>

                    <span>
                        Employees
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        Attendance
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-calendar-days"></i>

                    <span>
                        Leave
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-money-check-dollar"></i>

                    <span>
                        Payroll
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-chart-line"></i>

                    <span>
                        Performance
                    </span>

                </a>

                <a href="#"
                   class="hrm-nav-link disabled">

                    <i class="fas fa-chart-column"></i>

                    <span>
                        Reports
                    </span>

                </a>
            }

        </nav>


        <!-- Logout -->

        <div class="hrm-sidebar-bottom">

            <a href="/Account/Logout"
               class="hrm-logout">

                <i class="fas fa-right-from-bracket"></i>

                <span>
                    Logout
                </span>

            </a>

        </div>

    </aside>


    <!-- Mobile Overlay -->

    <div id="hrmOverlay"
         class="hrm-overlay">
    </div>


    <!-- =========================================
         MAIN
         ========================================= -->

    <main class="hrm-main">

        <!-- Topbar -->

        <header class="hrm-topbar">

            <div class="d-flex align-items-center gap-3">

                <button id="hrmMobileToggle"
                        class="hrm-mobile-toggle">

                    <i class="fas fa-bars"></i>

                </button>

                <div class="hrm-topbar-title">
                    @ViewData["Title"]
                </div>

            </div>


            <div class="hrm-topbar-right">

                @if (!string.IsNullOrWhiteSpace(companyName))
                {
                    <span class="hrm-company-badge">

                        <i class="fas fa-building me-1"></i>

                        @companyName

                    </span>
                }

                <span class="hrm-user-display">

                    <i class="fas fa-user-circle"></i>

                    @userName

                </span>

            </div>

        </header>


        <!-- Page Content -->

        <div class="hrm-page-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3">

                    <i class="fas fa-check-circle me-2"></i>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3">

                    <i class="fas fa-exclamation-circle me-2"></i>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @RenderBody()

        </div>

    </main>


    <!-- Bootstrap -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Mobile Sidebar -->

    <script>

            const hrmToggle =
                document.getElementById("hrmMobileToggle");

            const hrmSidebar =
                document.getElementById("hrmSidebar");

            const hrmOverlay =
                document.getElementById("hrmOverlay");


            hrmToggle?.addEventListener("click", function() {

                hrmSidebar?.classList.toggle("open");

                hrmOverlay?.classList.toggle("open");

            });


            hrmOverlay?.addEventListener("click", function() {

                hrmSidebar?.classList.remove("open");

                hrmOverlay?.classList.remove("open");

            });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>