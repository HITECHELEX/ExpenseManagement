@{
    ViewData["Title"] = "Salary Configuration";

    var employee =
        ViewBag.Employee as ExpenseManagement.Models.Employee;

    var salary =
        ViewBag.Salary as ExpenseManagement.Models.SalaryMaster;

    var salaryHistory =
    ViewBag.SalaryHistory
        as List<ExpenseManagement.Models.SalaryMaster>
        ?? new List<ExpenseManagement.Models.SalaryMaster>();

    bool isEdit = salary != null;
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Current Salary Configuration
            </h2>

            <p class="text-muted mb-0">
                Configure the salary structure for this employee.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Payroll
        </a>

    </div>


    <!-- Employee Details -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                Employee Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="text-muted small">
                        Employee Name
                    </label>

                    <div class="fw-semibold">
                        @employee?.User?.FullName
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">
                        Employee ID
                    </label>

                    <div class="fw-semibold">
                        @employee?.EmployeeCode
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">
                        Department
                    </label>

                    <div class="fw-semibold">
                        @employee?.User?.Department
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">
                        Designation
                    </label>

                    <div class="fw-semibold">
                        @employee?.Designation
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">
                        Date of Joining
                    </label>

                    <div class="fw-semibold">
                        @(employee?.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")
                    </div>
                </div>

            </div>

        </div>
    </div>


    <form asp-action="Salary"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="employeeId"
               value="@employee?.Id" />

        <input type="hidden"
               name="salaryId"
               value="@salary?.Id" />


        <!-- Validation -->
        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- Statutory Information -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Statutory Information
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">

                        <label class="form-label">
                            PAN Number
                        </label>

                        <input type="text"
                               name="panNumber"
                               class="form-control"
                               maxlength="20"
                               value="@salary?.PANNumber" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            UAN Number
                        </label>

                        <input type="text"
                               name="uanNumber"
                               class="form-control"
                               maxlength="30"
                               value="@salary?.UANNumber" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            ESIC Number
                        </label>

                        <input type="text"
                               name="esicNumber"
                               class="form-control"
                               maxlength="30"
                               value="@salary?.ESICNumber" />

                    </div>

                </div>

            </div>
        </div>


        <!-- Salary Structure -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Monthly Salary Structure
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">

                        <label class="form-label">
                            Basic Salary
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   name="basicSalary"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   required
                                   value="@salary?.BasicSalary" />
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            HRA
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   name="hra"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   required
                                   value="@salary?.HRA" />
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Conveyance Allowance
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   name="conveyanceAllowance"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   required
                                   value="@salary?.ConveyanceAllowance" />
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Washing Allowance
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   name="washingAllowance"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   value="@salary?.WashingAllowance" />
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Other Allowances
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                ₹
                            </span>

                            <input type="number"
                                   name="otherAllowances"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   value="@salary?.OtherAllowances" />
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Statutory Applicability -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Deduction Applicability
                </h5>

                <small class="text-muted">
                    Select which deductions apply to this employee.
                </small>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-3">

                        <div class="form-check form-switch">

                            <input type="checkbox"
                                   class="form-check-input"
                                   name="pfApplicable"
                                   value="true"
                            @(salary == null || salary.PFApplicable
                                ? "checked"
                                : "") />

                            <input type="hidden"
                                   name="pfApplicable"
                                   value="false" />

                            <label class="form-check-label">
                                PF Applicable
                            </label>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-check form-switch">

                            <input type="checkbox"
                                   class="form-check-input"
                                   name="esicApplicable"
                                   value="true"
                            @(salary == null || salary.ESICApplicable
                                ? "checked"
                                : "") />

                            <input type="hidden"
                                   name="esicApplicable"
                                   value="false" />

                            <label class="form-check-label">
                                ESIC Applicable
                            </label>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-check form-switch">

                            <input type="checkbox"
                                   class="form-check-input"
                                   name="professionalTaxApplicable"
                                   value="true"
                            @(salary == null ||
                              salary.ProfessionalTaxApplicable
                                ? "checked"
                                : "") />

                            <input type="hidden"
                                   name="professionalTaxApplicable"
                                   value="false" />

                            <label class="form-check-label">
                                Professional Tax
                            </label>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="form-check form-switch">

                            <input type="checkbox"
                                   class="form-check-input"
                                   name="lwfApplicable"
                                   value="true"
                            @(salary == null || salary.LWFApplicable
                                ? "checked"
                                : "") />

                            <input type="hidden"
                                   name="lwfApplicable"
                                   value="false" />

                            <label class="form-check-label">
                                LWF Applicable
                            </label>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Effective Date -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Salary Revision
                </h5>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4">

                        <label class="form-label">
                            Effective From
                        </label>

                        <input type="date"
                               name="effectiveFrom"
                               class="form-control"
                               required
                               value="@(salary?.EffectiveFrom == null
                                                           ? DateTime.UtcNow
                                                               .AddHours(5)
                                                               .AddMinutes(30)
                                                               .ToString("yyyy-MM-dd")
                                                           : salary.EffectiveFrom
                                                               .ToString("yyyy-MM-dd"))" />

                        <div class="form-text">
                            This salary structure will apply from
                            this date.
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2 mb-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="fas fa-save me-1"></i>

                @(isEdit
    ? "Revise Salary"
    : "Save Salary")

            </button>

        </div>

    </form>
    <!-- Salary History -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-0 fw-bold">
                        Salary History
                    </h5>

                    <small class="text-muted">
                        Previous salary structures for this employee.
                    </small>
                </div>

                <span class="badge bg-light text-dark">
                    @salaryHistory.Count revision@(salaryHistory.Count == 1 ? "" : "s")
                </span>

            </div>
        </div>

        <div class="card-body p-0">

            @if (salaryHistory.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Effective From</th>
                                <th>Basic Salary</th>
                                <th>HRA</th>
                                <th>Conveyance</th>
                                <th>Washing</th>
                                <th>Other Allowances</th>
                                <th>Total Monthly</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in salaryHistory)
                            {
                                var totalMonthly =
                                    item.BasicSalary +
                                    item.HRA +
                                    item.ConveyanceAllowance +
                                    item.WashingAllowance +
                                    item.OtherAllowances;

                                <tr>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.EffectiveFrom.ToString("dd-MMM-yyyy")
                                        </span>
                                    </td>

                                    <td>
                                        ₹@item.BasicSalary.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@item.HRA.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@item.ConveyanceAllowance.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@item.WashingAllowance.ToString("N2")
                                    </td>

                                    <td>
                                        ₹@item.OtherAllowances.ToString("N2")
                                    </td>

                                    <td class="fw-semibold">
                                        ₹@totalMonthly.ToString("N2")
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Current
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Historical
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No salary history is available.
                </div>
            }

        </div>

    </div>
</div>