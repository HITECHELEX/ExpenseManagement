@using System.Globalization

@{
    ViewData["Title"] = "Process Payroll";

    var employee = ViewBag.Employee as ExpenseManagement.Models.Employee;
    var salary = ViewBag.Salary as ExpenseManagement.Models.SalaryMaster;
    var payroll = ViewBag.Payroll as ExpenseManagement.Models.Payroll;

    int month = ViewBag.Month;
    int year = ViewBag.Year;

   bool isCurrentMonth = ViewBag.IsCurrentMonth ?? false;
bool isPastMonth = ViewBag.IsPastMonth ?? false;
bool isFutureMonth = ViewBag.IsFutureMonth ?? false;

bool isPreview = ViewBag.IsPreview ?? false;

var todayIndia = DateTime.UtcNow
    .AddHours(5)
    .AddMinutes(30)
    .Date;

var lastDayOfMonth = new DateTime(
    year,
    month,
    DateTime.DaysInMonth(year, month));

bool isLastThreeDays = isCurrentMonth;

bool isProcessed =
    payroll?.Status == "Processed";

    decimal workingDays = ViewBag.WorkingDays ?? 0m;
    decimal payDays = ViewBag.PayDays ?? 0m;
    decimal paidDays = ViewBag.PaidDays ?? 0m;
    decimal lop = ViewBag.LOP ?? 0m;

    decimal monthlyGross = ViewBag.MonthlyGross ?? 0m;
    decimal earnedGross = ViewBag.EarnedGross ?? 0m;

    var monthName =
        CultureInfo.CurrentCulture
            .DateTimeFormat
            .GetMonthName(month);

    bool isFinalized =
        payroll?.Status == "Finalized";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
    @(isCurrentMonth && !isLastThreeDays
        ? "Payroll Preview"
        : "Process Payroll")
</h2>

            <p class="text-muted mb-0">
                @monthName @year

                @if (isCurrentMonth)
                {
                    <span class="badge bg-info text-dark ms-2">
                        Current Month
                    </span>
                }
            </p>
        </div>

        <a asp-action="Index"
           asp-route-month="@month"
           asp-route-year="@year"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Payroll
        </a>

    </div>


    <!-- Employee Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                Employee Details
            </h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <div class="text-muted small">
                        Employee
                    </div>

                    <div class="fw-semibold">
                        @employee?.User?.FullName
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Employee Code
                    </div>

                    <div class="fw-semibold">
                        @employee?.EmployeeCode
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Department
                    </div>

                    <div class="fw-semibold">
                        @employee?.User?.Department
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Designation
                    </div>

                    <div class="fw-semibold">
                        @employee?.Designation
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small">
                        Date of Joining
                    </div>

                    <div class="fw-semibold">
                        @(employee?.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- Attendance Calculation -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                Attendance & Pay Calculation
            </h5>
            @if (isCurrentMonth)
            {
                <div class="alert alert-info mb-3">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>Payroll can be processed at any time.</strong>
                    <span>
                        Attendance and leave are evaluated through
                        <strong>@todayIndia.ToString("dd-MMM-yyyy")</strong>.
                        Days after today are not included. If attendance or leave changes later,
                        reprocess before finalizing, or reopen the payroll if it is already finalized.
                    </span>
                </div>
            }

            @{
                var noOutPunchDays = (int)(ViewBag.NoOutPunchDays ?? 0);
            }

            @if (noOutPunchDays > 0)
            {
                <div class="alert alert-warning mb-3">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    <strong>@noOutPunchDays day(s)</strong> have a missing punch and are paid as full days.
                    Review them on the attendance page before processing.
                </div>
            }
        </div>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">
                            Working Days
                        </div>

                        <div class="fs-4 fw-bold">
                            @workingDays.ToString("0.##")
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">
                            Pay Days
                        </div>

                        <div class="fs-4 fw-bold">
                            @payDays.ToString("0.##")
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">
                            Paid Days
                        </div>

                        <div class="fs-4 fw-bold">
                            @paidDays.ToString("0.##")
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">
                            LOP
                        </div>

                        <div class="fs-4 fw-bold text-danger">
                            @lop.ToString("0.##")
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>


    <form asp-action="Process"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="employeeId"
               value="@employee?.Id" />

        <input type="hidden"
               name="month"
               value="@month" />

        <input type="hidden"
               name="year"
               value="@year" />


        <!-- Salary -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Earnings
                </h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>
                                    Description
                                </th>

                                <th class="text-end">
                                    Monthly Rate
                                </th>

                                <th class="text-end">
                                    Payable
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>Basic</td>

                                <td class="text-end">
                                    ₹@salary.BasicSalary.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@(
                                        ((salary.BasicSalary / workingDays)
                                        * paidDays)
                                        .ToString("N2")
                                    )
                                </td>
                            </tr>

                            <tr>
                                <td>HRA</td>

                                <td class="text-end">
                                    ₹@salary.HRA.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@(
                                        ((salary.HRA / workingDays)
                                        * paidDays)
                                        .ToString("N2")
                                    )
                                </td>
                            </tr>

                            <tr>
                                <td>Conveyance Allowance</td>

                                <td class="text-end">
                                    ₹@salary.ConveyanceAllowance.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@(
                                        ((salary.ConveyanceAllowance / workingDays)
                                        * paidDays)
                                        .ToString("N2")
                                    )
                                </td>
                            </tr>

                            <tr>
                                <td>Other Allowance</td>

                                <td class="text-end">
                                    ₹@(
                                        (salary.WashingAllowance +
                                         salary.OtherAllowances)
                                        .ToString("N2")
                                    )
                                </td>

                                <td class="text-end">
                                    ₹@(
                                        (((salary.WashingAllowance +
                                           salary.OtherAllowances)
                                          / workingDays)
                                         * paidDays)
                                        .ToString("N2")
                                    )
                                </td>
                            </tr>

                        </tbody>

                        <tfoot>

                            <tr class="fw-bold">

                                <td colspan="2">
                                    Gross Earnings
                                </td>

                                <td class="text-end">
                                    ₹@earnedGross.ToString("N2")
                                </td>

                            </tr>

                        </tfoot>

                    </table>

                </div>

            </div>
        </div>


        <!-- Fixed Deductions -->
<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            Employee Deductions
        </h5>

        <small class="text-muted">
            PF, ESIC, Professional Tax and LWF are controlled by Payroll Deduction Settings.
            Other Deductions can be entered manually.
        </small>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-3">

                <label class="form-label">
                    PF
                </label>

                <input type="number"
                       name="pf"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@(ViewBag.PF ?? payroll?.PF ?? 0)"
                       readonly />

                <small class="text-muted">
                    Company configured
                </small>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    ESIC
                </label>

                <input type="number"
                       name="esi"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@(ViewBag.ESI ?? payroll?.ESI ?? 0)"
                       readonly />

                <small class="text-muted">
                    Company configured
                </small>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    Professional Tax
                </label>

                <input type="number"
                       name="professionalTax"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@(ViewBag.ProfessionalTax ?? payroll?.ProfessionalTax ?? 0)"
                       readonly />

                <small class="text-muted">
                    Company configured
                </small>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    LWF
                </label>

                <input type="number"
                       name="lwf"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@(ViewBag.LWF ?? payroll?.LWF ?? 0)"
                       readonly />

                <small class="text-muted">
                    Company configured
                </small>

            </div>

            <div class="col-md-3">

                <label class="form-label">
                    Other Deductions
                </label>

                <input type="number"
                       name="otherDeductions"
                       class="form-control"
                       min="0"
                       step="0.01"
                       value="@(ViewBag.OtherDeductions ?? payroll?.OtherDeductions ?? 0)" />

                <small class="text-muted">
                    Manual entry
                </small>

            </div>

        </div>

    </div>
</div>


        <!-- Final -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">
                    Payroll Summary
                </h5>
            </div>

            <div class="card-body">

                @{
                    decimal previewPF =
                        ViewBag.PF ?? payroll?.PF ?? 0m;

                    decimal previewESI =
                        ViewBag.ESI ?? payroll?.ESI ?? 0m;

                    decimal previewPT =
                        ViewBag.ProfessionalTax ?? payroll?.ProfessionalTax ?? 0m;

                    decimal previewLWF =
                        ViewBag.LWF ?? payroll?.LWF ?? 0m;

                    decimal previewOther =
                        ViewBag.OtherDeductions ?? payroll?.OtherDeductions ?? 0m;

                    decimal previewTotalDeductions =
                        ViewBag.TotalDeductions
                        ?? (
                            previewPF +
                            previewESI +
                            previewPT +
                            previewLWF +
                            previewOther
                        );

                    decimal previewNetSalary =
                        ViewBag.NetSalary
                        ?? (
                            earnedGross -
                            previewTotalDeductions
                        );
                }

                <div class="row">

                    <div class="col-md-6">

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                Gross Earnings
                            </span>

                            <strong>
                                ₹@earnedGross.ToString("N2")
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                PF
                            </span>

                            <span>
                                ₹@previewPF.ToString("N2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                ESIC
                            </span>

                            <span>
                                ₹@previewESI.ToString("N2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                Professional Tax
                            </span>

                            <span>
                                ₹@previewPT.ToString("N2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                LWF
                            </span>

                            <span>
                                ₹@previewLWF.ToString("N2")
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>
                                Other Deductions
                            </span>

                            <span>
                                ₹@previewOther.ToString("N2")
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <strong>
                                Gross Deductions
                            </strong>

                            <strong>
                                ₹@previewTotalDeductions.ToString("N2")
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between fs-5">
                            <strong>
                                Net Pay
                            </strong>

                            <strong>
                                ₹@previewNetSalary.ToString("N2")
                            </strong>
                        </div>

                    </div>

                </div>

            </div>
        </div>


        <!-- Remarks -->
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <label class="form-label">
                    Remarks
                </label>

                <textarea name="remarks"
                          class="form-control"
                          rows="3">@payroll?.Remarks</textarea>

            </div>
        </div>


        <!-- Actions -->
        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               asp-route-month="@month"
               asp-route-year="@year"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            @if (isFinalized)
            {
                <button type="button"
                        class="btn btn-secondary"
                        disabled>
                    Payroll Finalized
                </button>
            }
            else
            {
                @if (isCurrentMonth || isPastMonth)
{
    <button type="submit"
            name="action"
            value="Preview"
            class="btn btn-outline-primary">
        <i class="fas fa-eye me-1"></i>
        Preview Payroll
    </button>

    <button type="submit"
            name="action"
            value="Process"
            class="btn btn-primary">
        <i class="fas fa-calculator me-1"></i>
        Process Payroll
    </button>
}
else
{
    <button type="button"
            class="btn btn-secondary"
            disabled>
        Payroll Not Available
    </button>
}
            }

        </div>

    </form>

</div>