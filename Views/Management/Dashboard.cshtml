@model ExpenseManagement.ViewModels.ManagementDashboardVM
@using ExpenseManagement.Models
@{
    ViewData["Title"] = "Dashboard";
    ViewBag.UnreadNotifications = Model.UnreadNotifications;
    decimal remaining = Model.TotalBudgetAllocated - Model.TotalSpent;
    double spentPct = Model.TotalBudgetAllocated > 0
        ? Math.Min(100, (double)(Model.TotalSpent / Model.TotalBudgetAllocated * 100)) : 0;
    string cq = Model.SelectedCompanyId.HasValue ? $"?companyId={Model.SelectedCompanyId}" : "";
    string cqAmp = Model.SelectedCompanyId.HasValue ? $"&companyId={Model.SelectedCompanyId}" : "";
}

@* ── COMPANY FILTER ── *@
@await Html.PartialAsync("_ManagementCompanyFilter")

@* ── HERO CARD ── *@
<div class="mb-4">
    <div style="background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);border-radius:20px;padding:24px 26px;color:#fff">
        <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;opacity:.75;margin-bottom:6px">
            <i class="fas fa-building-columns me-2"></i>@(Model.SelectedCompanyId.HasValue ? Model.SelectedCompanyName : "All Companies") — Budget Overview
        </div>
        <div style="font-size:clamp(1.6rem,6vw,2.8rem);font-weight:800;letter-spacing:-1px;line-height:1;margin-bottom:16px">
            ₹@Model.TotalBudgetAllocated.ToString("N2")
        </div>
        <div style="font-size:.72rem;opacity:.7;margin-bottom:14px;margin-top:-12px">Total budget allocated across all employees</div>

        <div class="row g-2">
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.72rem,2.5vw,1rem);font-weight:700">₹@Model.TotalSpent.ToString("N0")</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Total Spent</div>
                </div>
            </div>
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.72rem,2.5vw,1rem);font-weight:700">₹@remaining.ToString("N0")</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Remaining</div>
                </div>
            </div>
            <div class="col-4">
                <div style="background:rgba(255,255,255,.13);border-radius:12px;padding:10px 6px;text-align:center">
                    <div style="font-size:clamp(.72rem,2.5vw,1rem);font-weight:700">@Model.TotalEmployees</div>
                    <div style="font-size:.62rem;opacity:.72;margin-top:2px">Employees</div>
                </div>
            </div>
        </div>

        @if (Model.TotalBudgetAllocated > 0)
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1" style="font-size:.72rem;opacity:.75">
                    <span>Budget Utilised</span><span>@spentPct.ToString("F0")%</span>
                </div>
                <div style="height:5px;background:rgba(255,255,255,.22);border-radius:99px;overflow:hidden">
                    <div style="height:100%;width:@spentPct.ToString("F1")%;background:@(spentPct > 90 ? "#f87171" : spentPct > 70 ? "#fbbf24" : "#4ade80");border-radius:99px;transition:width .5s"></div>
                </div>
            </div>
        }
    </div>
</div>

@* ── REPORT STATUS CARDS (clickable) ── *@
<div class="row g-3 mb-4">
    <div class="col-4">
        <a href="/Management/Reports?status=ForwardedToManagement@(cqAmp)" class="text-decoration-none">
            <div style="background:#fff;border:1.5px solid #fde68a;border-radius:14px;padding:16px 10px;text-align:center;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 4px 16px rgba(245,158,11,.15)'" onmouseout="this.style.boxShadow=''">
                <div style="font-size:clamp(1.4rem,5vw,2rem);font-weight:800;color:#f59e0b">@Model.ReportsForReview</div>
                <div style="font-size:.72rem;color:#92400e;font-weight:500;margin-top:2px">Pending Review</div>
                <div style="font-size:.65rem;color:#b45309;margin-top:4px"><i class="fas fa-arrow-right me-1"></i>View</div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="/Management/Reports?status=ApprovedByManagement@(cqAmp)" class="text-decoration-none">
            <div style="background:#fff;border:1.5px solid #86efac;border-radius:14px;padding:16px 10px;text-align:center;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 4px 16px rgba(22,163,74,.15)'" onmouseout="this.style.boxShadow=''">
                <div style="font-size:clamp(1.4rem,5vw,2rem);font-weight:800;color:#16a34a">@Model.ApprovedReports</div>
                <div style="font-size:.72rem;color:#14532d;font-weight:500;margin-top:2px">Approved</div>
                <div style="font-size:.65rem;color:#166534;margin-top:4px"><i class="fas fa-arrow-right me-1"></i>View</div>
            </div>
        </a>
    </div>
    <div class="col-4">
        <a href="/Management/Reports?status=RejectedByManagement@(cqAmp)" class="text-decoration-none">
            <div style="background:#fff;border:1.5px solid #fca5a5;border-radius:14px;padding:16px 10px;text-align:center;transition:box-shadow .2s" onmouseover="this.style.boxShadow='0 4px 16px rgba(239,68,68,.15)'" onmouseout="this.style.boxShadow=''">
                <div style="font-size:clamp(1.4rem,5vw,2rem);font-weight:800;color:#ef4444">@Model.RejectedReports</div>
                <div style="font-size:.72rem;color:#7f1d1d;font-weight:500;margin-top:2px">Rejected</div>
                <div style="font-size:.65rem;color:#991b1b;margin-top:4px"><i class="fas fa-arrow-right me-1"></i>View</div>
            </div>
        </a>
    </div>
</div>

@* ── REPORTS AWAITING REVIEW ── *@
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h6 class="fw-bold mb-0" style="font-size:.95rem">
            <i class="fas fa-file-invoice me-2 text-primary"></i>Reports Awaiting Review
            @if (Model.ReportsForReview > 0)
            {
                <span style="background:#fef3c7;color:#b45309;border-radius:99px;font-size:.65rem;padding:2px 8px;font-weight:700;margin-left:4px">@Model.ReportsForReview pending</span>
            }
        </h6>
        <a href="/Management/Reports@(cq)" class="btn btn-sm btn-primary" style="border-radius:9px;padding:5px 14px;font-size:.8rem">
            View All
        </a>
    </div>

    @if (!Model.RecentReports.Any())
    {
        <div class="text-center py-5" style="background:#f8fafc;border:1.5px dashed #e2e8f0;border-radius:16px">
            <div style="width:52px;height:52px;background:#f1f5f9;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px">
                <i class="fas fa-check-circle" style="color:#22c55e;font-size:1.4rem"></i>
            </div>
            <div class="fw-semibold" style="color:#334155;font-size:.9rem">All clear!</div>
            <div class="text-muted mt-1" style="font-size:.8rem">No reports pending your review</div>
        </div>
    }
    else
    {
        var colors = new[] { "#dbeafe|#1d4ed8", "#dcfce7|#16a34a", "#fef3c7|#d97706", "#f3e8ff|#7c3aed", "#fce7f3|#be185d" };
        <div class="d-flex flex-column gap-2">
            @foreach (var (r, i) in Model.RecentReports.Select((r, i) => (r, i)))
            {
                var cPair    = colors[i % colors.Length].Split('|');
                var initials = string.Join("", (r.Employee?.FullName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
                <div style="background:#fff;border:1.5px solid #e2e8f0;border-radius:14px;padding:14px 16px">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-3" style="min-width:0;flex:1 1 0">
                            <div style="width:40px;height:40px;border-radius:10px;background:@cPair[0];color:@cPair[1];display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;flex-shrink:0">
                                @initials
                            </div>
                            <div style="min-width:0">
                                <div class="fw-bold text-truncate" style="font-size:.92rem">@r.ReportTitle</div>
                                <div class="d-flex gap-2 flex-wrap mt-1" style="font-size:.72rem;color:#64748b">
                                    <span><i class="fas fa-user me-1"></i>@r.Employee?.FullName</span>
                                    <span><i class="fas fa-receipt me-1"></i>@r.ExpenseClaims.Count expense@(r.ExpenseClaims.Count == 1 ? "" : "s")</span>
                                    <span class="fw-semibold" style="color:#2563eb">₹@r.TotalClaimed.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                        <a href="/Management/ReportDetail/@r.Id" class="btn btn-sm btn-primary flex-shrink-0" style="border-radius:8px;font-size:.78rem;padding:6px 14px">
                            <i class="fas fa-eye me-1"></i>Review
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── BOTTOM LINKS ── *@
<div class="d-flex gap-2 flex-wrap">
    <a href="/Management/Reports@(cq)" class="btn btn-outline-primary flex-fill" style="border-radius:10px;padding:9px">
        <i class="fas fa-file-invoice me-2"></i>All Reports
    </a>
    <a href="/Management/Overview@(cq)" class="btn btn-outline-secondary flex-fill" style="border-radius:10px;padding:9px">
        <i class="fas fa-users me-2"></i>Employees
    </a>
</div>
