@model List<ExpenseManagement.Models.User>
@{
    ViewData["Title"] = "Employee Overview";
    int? companyId = ViewBag.SelectedCompanyId as int?;
}

@await Html.PartialAsync("_ManagementCompanyFilter")

<h5 class="mb-3"><i class="fas fa-users me-2"></i>Employee Overview</h5>
<div class="table-responsive">
    <table class="table table-hover">
        <thead><tr>
            <th>Employee</th>
            @if (companyId == null) { <th>Company</th> }
            <th>Department</th>
            <th>Active Budgets</th>
            <th>Total Allocated</th>
            <th>Total Spent</th>
        </tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                var active = e.Budgets.Where(b => b.IsActive);
                <tr>
                    <td><div class="fw-semibold">@e.FullName</div><small class="text-muted">@e.Email</small></td>
                    @if (companyId == null)
                    {
                        <td>
                            <span class="badge" style="background:#eff6ff;color:#2563eb;font-size:.72rem">
                                <i class="fas fa-building me-1"></i>@e.Company?.Name
                            </span>
                        </td>
                    }
                    <td>@e.Department</td>
                    <td>@active.Count()</td>
                    <td>₹@active.Sum(b => b.TotalAmount).ToString("N0")</td>
                    <td>₹@active.Sum(b => b.SpentAmount).ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
